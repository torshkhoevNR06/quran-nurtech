---
import { getSurah, getTafsir, getIbnKathir, getSurahMeta, ref } from '../lib/quran';
import { icons } from '../lib/icons';

export type TranslationId = 'kuliev' | 'abuadel' | 'saadi' | 'ibn-kathir';
export interface Props {
  surahId: number;
  translation: TranslationId;
}
const { surahId, translation } = Astro.props;
const surah = getSurah(surahId);
const meta = getSurahMeta(surahId)!;

const isAbuAdel = translation === 'abuadel';
const isSaadi = translation === 'saadi';
const isIbnKathir = translation === 'ibn-kathir';

const tafsir = isSaadi ? getTafsir(surahId) : []; // ас-Саади по диапазонам
const ik = isIbnKathir ? getIbnKathir(surahId) : []; // Ибн Касир по аятам
const blockFor = (a: number) => tafsir.find((b) => a >= b.f && a <= b.t);
const ikFor = (a: number) => ik.find((b) => b.a === a);

const labels: Record<TranslationId, string> = {
  kuliev: 'Перевод Кулиева',
  abuadel: 'Перевод Абу Аделя',
  saadi: 'Тафсир ас-Саади',
  'ibn-kathir': 'Тафсир Ибн Касира',
};
const isMecca = meta.t === 'мекканская';
const prevN = surahId > 1 ? surahId - 1 : null;
const nextN = surahId < 114 ? surahId + 1 : null;
const arName = surah.na.replace('سُورَةُ ', '');
---

<div class="container">
  <nav class="crumb">
    <a href="/">Главная</a><span>›</span><span>Сура {surah.n}</span><span>›</span>
    <span>{surah.nr}</span>
  </nav>

  <header class="surah-head">
    <div class="kicker">Сура №{surah.n} · {surah.nm}</div>
    <div class="ar">{arName}</div>
    <h1>{surah.nr}</h1>
    <div class="meta">
      <span class={`chip ${isMecca ? 'mecca' : 'medina'}`}>{meta.t}</span>
      <span class="chip">{surah.c} аятов</span>
      <span class="chip">{labels[translation]}</span>
    </div>
  </header>

  <p class="surah-desc">
    <strong>{surah.nr}</strong> ({surah.nm}) — {meta.t} сура Корана под номером {surah.n},
    состоит из {surah.c} аятов. Ниже приведён арабский текст (Усмани) и {labels[translation].toLowerCase()}.
    Переключить перевод/тафсир, чтеца, размер шрифта и тему можно в верхней панели.
  </p>

  <div class="ayahs" data-ayahs data-view="all" data-surah-name={surah.nr}>
    {surah.bism && <div class="bism">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>}

    {
      surah.a.map((ayah) => {
        const blk = blockFor(ayah.n);
        const isRangeEnd = isSaadi && blk && ayah.n === blk.t;
        const ikBlk = isIbnKathir ? ikFor(ayah.n) : undefined;
        const text = isAbuAdel ? ayah.aa || ayah.ru : ayah.ru;
        return (
          <>
            <article class="ayah" id={`ayah-${ayah.n}`} data-ayah-key={ref(surah.n, ayah.n)}>
              <div class="ayah-top">
                <a class="ayah-no" href={`/ayah/${surah.n}/${ayah.n}`} title="Открыть аят">{surah.n}:{ayah.n}</a>
                <div class="ayah-acts">
                  <button type="button" data-act="play" aria-label="Слушать аят" title="Слушать" set:html={icons.play} />
                  <button type="button" data-bm={ref(surah.n, ayah.n)} aria-label="В закладки" title="Закладка" set:html={icons.bookmark} />
                  <button type="button" data-act="copy" aria-label="Копировать" title="Копировать" set:html={icons.copy} />
                  <button type="button" data-act="share" aria-label="Поделиться" title="Поделиться" set:html={icons.share} />
                  <a href={`/ayah/${surah.n}/${ayah.n}`} aria-label="Открыть аят" title="Открыть аят" set:html={icons.details} />
                </div>
              </div>
              <div class="ar" set:html={ayah.ar} />
              <div class="translation">{text}</div>
              {ikBlk && (
                <details class="tafsir-details">
                  <summary>Тафсир Ибн Касира · аят {surah.n}:{ayah.n}</summary>
                  <div class="tafsir">{ikBlk.x}</div>
                </details>
              )}
            </article>
            {isRangeEnd && (
              <div class="ayah tafsir-passage">
                <span class="tafsir-label">Тафсир ас-Саади · аяты {blk!.f}–{blk!.t}</span>
                <div class="tafsir">{blk!.x}</div>
              </div>
            )}
          </>
        );
      })
    }
  </div>

  <nav class="ayah-nav">
    {prevN ? (
      <a class="btn" href={`/surah/${prevN}`}>
        <span set:html={icons.arrowLeft} style="width:16px;height:16px" /> Пред. сура
      </a>
    ) : (
      <span />
    )}
    {nextN && (
      <a class="btn" href={`/surah/${nextN}`}>
        След. сура <span set:html={icons.arrowRight} style="width:16px;height:16px" />
      </a>
    )}
  </nav>
</div>
