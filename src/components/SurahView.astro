---
import { getSurah, getTafsir, getIbnKathir, getSurahMeta, ref } from '../lib/quran';
import { icons } from '../lib/icons';

export type TranslationId = 'kuliev' | 'abuadel' | 'saadi' | 'ibn-kathir';
export interface Props {
  surahId: number;
  translation: TranslationId;
  inlineTafsir?: boolean;
}
const { surahId, translation, inlineTafsir = false } = Astro.props;
const surah = getSurah(surahId);
const meta = getSurahMeta(surahId)!;

const isAbuAdel = translation === 'abuadel';
const isSaadi = translation === 'saadi';
const isIbnKathir = translation === 'ibn-kathir';

// inlineTafsir=true — тафсир под каждым аятом лениво по клику (без «стены текста»):
// это дефолтная страница чтения и режимы Кулиев/Абу Адель. На роутах /saadi и
// /ibn-kathir (inlineTafsir=false) тафсир печатается сплошняком — полное чтение.
const showTafsirToggle = inlineTafsir;
const showSaadiWall = isSaadi && !inlineTafsir;
const showIkWall = isIbnKathir && !inlineTafsir;

const tafsir = showSaadiWall ? getTafsir(surahId) : []; // ас-Саади по аятам
const ik = showIkWall ? getIbnKathir(surahId) : []; // Ибн Касир по аятам
const blockFor = (a: number) => tafsir.find((b) => b.a === a);
const ikFor = (a: number) => ik.find((b) => b.a === a);

// границы джузов и страниц мусхафа в этой суре (маркеры навигации)
let _pj: number | null = null;
let _pp: number | null = null;
const juzAt: Record<number, number> = {};
const pageAt: Record<number, number> = {};
for (const a of surah.a) {
  if (a.j && a.j !== _pj) {
    juzAt[a.n] = a.j;
    _pj = a.j;
  }
  if (a.p && a.p !== _pp) {
    pageAt[a.n] = a.p;
    _pp = a.p;
  }
}

const labels: Record<TranslationId, string> = {
  kuliev: 'Перевод Кулиева',
  abuadel: 'Перевод Абу Аделя',
  saadi: 'Тафсир ас-Саади',
  'ibn-kathir': 'Тафсир Ибн Касира',
};
const isMecca = meta.t === 'мекканская';
const prevN = surahId > 1 ? surahId - 1 : null;
const nextN = surahId < 114 ? surahId + 1 : null;
const arName = surah.na.replace('سُورَةُ ', '');
---

<div class="container">
  <nav class="crumb">
    <a href="/">Главная</a><span>›</span><span>Сура {surah.n}</span><span>›</span>
    <span>{surah.nr}</span>
  </nav>

  <header class="surah-head">
    <div class="kicker">Сура №{surah.n} · {surah.nm}</div>
    <h1>{surah.nr}</h1>
    <div class="ar">{arName}</div>
    <div class="meta">
      <span class={`chip ${isMecca ? 'mecca' : 'medina'}`}>{meta.t}</span>
      <span class="chip">{surah.c} аятов</span>
      <span class="chip">{labels[translation]}</span>
    </div>
  </header>

  <details class="surah-desc">
    <summary>Описание суры и режима чтения</summary>
    <p>
      <strong>{surah.nr}</strong> ({surah.nm}) — {meta.t} сура Корана под номером {surah.n},
      состоит из {surah.c} аятов. Ниже приведён арабский текст (Усмани) и {labels[translation].toLowerCase()}.
      Перевод, чтец, размер шрифта и тему можно изменить в верхней панели.
    </p>
  </details>

  <div
    class="ayahs"
    data-ayahs
    data-view="all"
    data-primary={isAbuAdel ? 'abuadel' : 'kuliev'}
    data-surah-name={surah.nr}
  >
    {surah.bism && <div class="bism">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>}

    {
      surah.a.map((ayah) => {
        const saadiBlk = showSaadiWall ? blockFor(ayah.n) : undefined;
        const ikBlk = showIkWall ? ikFor(ayah.n) : undefined;
        return (
          <>
            {juzAt[ayah.n] && (
              <div class="juz-sep" id={`juz-${juzAt[ayah.n]}`}>
                <span>Джуз {juzAt[ayah.n]}</span>
              </div>
            )}
            {pageAt[ayah.n] && !juzAt[ayah.n] && (
              <div class="page-sep">Страница {pageAt[ayah.n]}</div>
            )}
            <article class="ayah" id={`ayah-${ayah.n}`} data-ayah-key={ref(surah.n, ayah.n)}>
              <div class="ayah-top">
                <a class="ayah-no" href={`/${surah.n}:${ayah.n}`} title="Открыть аят">{surah.n}:{ayah.n}</a>
                <div class="ayah-acts">
                  <button type="button" data-act="play" aria-label="Слушать аят" title="Слушать" set:html={icons.play} />
                  <button type="button" data-bm={ref(surah.n, ayah.n)} aria-label="В закладки" title="Закладка" set:html={icons.bookmark} />
                  <button class="secondary-action" type="button" data-act="copy" aria-label="Копировать" title="Копировать" set:html={icons.copy} />
                  <button class="secondary-action" type="button" data-act="share" aria-label="Поделиться" title="Поделиться" set:html={icons.share} />
                  <a href={`/${surah.n}:${ayah.n}`} aria-label="Открыть аят" title="Открыть аят" set:html={icons.details} />
                </div>
              </div>
              <div class="ar" set:html={ayah.ar} />
              {ayah.tl && <div class="translit">{ayah.tl}</div>}
              <div class="tr-block">
                <div class="translation tr-kuliev"><span class="tr-lbl">Кулиев</span>{ayah.ru}</div>
                {ayah.aa && (
                  <div class="translation tr-abuadel"><span class="tr-lbl">Абу Адель</span>{ayah.aa}</div>
                )}
              </div>
              {showTafsirToggle && (
                <div class="tafsir-toggles">
                  <button class="tafsir-toggle" type="button" data-act="tafsir" data-src="saadi" aria-expanded="false" title="Тафсир ас-Саади">
                    <span class="tt-ic" set:html={icons.book} />
                    <span class="tt-tx">Тафсир ас-Саади</span>
                    <span class="tt-caret" set:html={icons.chevron} />
                  </button>
                  <button class="tafsir-toggle" type="button" data-act="tafsir" data-src="ik" aria-expanded="false" title="Тафсир Ибн Касира">
                    <span class="tt-ic" set:html={icons.book} />
                    <span class="tt-tx">Тафсир Ибн Касира</span>
                    <span class="tt-caret" set:html={icons.chevron} />
                  </button>
                </div>
              )}
              {saadiBlk && (
                <div class="tafsir-passage">
                  <span class="tafsir-label">Тафсир ас-Саади · аят {surah.n}:{ayah.n}</span>
                  <div class="tafsir">{saadiBlk.x}</div>
                </div>
              )}
              {ikBlk && (
                <details class="tafsir-details">
                  <summary>Тафсир Ибн Касира · аят {surah.n}:{ayah.n}</summary>
                  <div class="tafsir">{ikBlk.x}</div>
                </details>
              )}
            </article>
          </>
        );
      })
    }
  </div>

  <nav class="ayah-nav">
    {prevN ? (
      <a class="btn" href={`/surah/${prevN}`}>
        <span set:html={icons.arrowLeft} style="width:16px;height:16px" /> Пред. сура
      </a>
    ) : (
      <span />
    )}
    {nextN && (
      <a class="btn" href={`/surah/${nextN}`}>
        След. сура <span set:html={icons.arrowRight} style="width:16px;height:16px" />
      </a>
    )}
  </nav>
</div>

<script>
  import '../client/reader-extras';
</script>

<style is:global>
  /* Заметки к аяту */
  .ayah-note-btn.has {
    color: var(--accent);
    opacity: 1 !important;
  }
  .ayah-note {
    margin-top: 12px;
    display: grid;
    gap: 6px;
    animation: ayahNoteIn 0.18s ease;
  }
  @keyframes ayahNoteIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .ayah-note textarea {
    width: 100%;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent) 5%, var(--panel-bg));
    color: var(--ink);
    padding: 11px 13px;
    font: 400 var(--fs-15) / 1.55 var(--sans);
    resize: vertical;
    min-height: 64px;
  }
  .ayah-note textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .ayah-note-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--fs-12);
    color: var(--ink-faint);
  }
  .ayah-note-del {
    border: 0;
    background: transparent;
    color: var(--low);
    font: 600 var(--fs-12) / 1 var(--sans);
    cursor: pointer;
    padding: 4px 6px;
  }
</style>
