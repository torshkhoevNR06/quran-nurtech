---
import { icons } from '../lib/icons';
import TopBarBrand from './topbar/TopBarBrand.astro';
import TopBarQuickSearch from './topbar/TopBarQuickSearch.astro';
import TopBarReaderMenus from './topbar/TopBarReaderMenus.astro';
import TopBarSettings from './topbar/TopBarSettings.astro';
import TopBarThemeToggle from './topbar/TopBarThemeToggle.astro';
import TopBarBookmarks from './topbar/TopBarBookmarks.astro';
import TopBarContinue from './topbar/TopBarContinue.astro';

const pathname = Astro.url.pathname;
const isReader =
  pathname.startsWith('/surah') || pathname.startsWith('/ayah') || /^\/\d+:\d+/.test(pathname);
const isSearch = pathname.startsWith('/search');
const isAudio = pathname.startsWith('/audio');
const isMushaf = pathname.startsWith('/mushaf');
const showReaderTools = isReader;
const showQuick = !isSearch;
---

<header class="topbar" role="banner">
  <div role="toolbar" aria-label="Панель инструментов" class={`topbar-inner ${isReader ? 'is-reader' : ''} ${isSearch ? 'is-search' : ''} ${isAudio ? 'is-audio' : ''} ${isMushaf ? 'is-mushaf' : ''}`}>
    <TopBarBrand />

    <TopBarQuickSearch showQuick={showQuick} />

    <a class="icon-btn" href="/search" aria-label="Поиск" title="Поиск (/)" set:html={icons.search} />
    <a class="icon-btn desktop-comfort" href="/mushaf/1" aria-label="Мусхаф" title="Мусхаф" set:html={icons.mushaf} />

    <TopBarReaderMenus showReaderTools={showReaderTools} />

    <TopBarSettings />

    <TopBarThemeToggle />

    <TopBarBookmarks />

    <TopBarContinue isReader={isReader} />
  </div>
</header>

<script>
  import '../client/topbar';
</script>
