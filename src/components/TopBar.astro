---
import { icons } from '../lib/icons';
import { getReciters, TRANSLATIONS } from '../lib/quran';

const reciters = getReciters();
const views = [
  { id: 'arabic', label: 'Араб' },
  { id: 'translation', label: 'Перевод' },
  { id: 'translit', label: 'Транслит' },
  { id: 'tafsir', label: 'Тафсир' },
  { id: 'compare', label: 'Сравн.' },
  { id: 'all', label: 'Всё' },
];
const fonts = [
  { id: 'Mushaf', label: 'Мусхаф' },
  { id: 'AmiriQuran', label: 'Амири' },
  { id: 'NaskhAr', label: 'Насх' },
];
const themes = [
  { id: 'light', label: 'Светлая' },
  { id: 'dark', label: 'Тёмная' },
  { id: 'sepia', label: 'Сепия' },
  { id: 'system', label: 'Системная' },
];
const pathname = Astro.url.pathname;
const isReader =
  pathname.startsWith('/surah') || pathname.startsWith('/ayah') || /^\/\d+:\d+/.test(pathname);
const isSearch = pathname.startsWith('/search');
const isAudio = pathname.startsWith('/audio');
const isMushaf = pathname.startsWith('/mushaf');
const showReaderTools = isReader;
const showQuick = !isSearch;
---

<header class="topbar" role="banner">
  <div role="toolbar" aria-label="Панель инструментов" class={`topbar-inner ${isReader ? 'is-reader' : ''} ${isSearch ? 'is-search' : ''} ${isAudio ? 'is-audio' : ''} ${isMushaf ? 'is-mushaf' : ''}`}>
    <button class="icon-btn only-mobile" data-act="drawer" aria-label="Список сур" set:html={icons.menu} />

    <a href="/" class="brand" aria-label="Коран онлайн — главная" title="На главную — выбор суры">
      <span class="brand-mark" aria-hidden="true">
        <img src="/brand-mark.png?v=g2" width="42" height="42" alt="" />
      </span>
      <span class="brand-copy">
        <span class="brand-name">Коран онлайн</span>
        <span class="brand-domain">quran.nurtech.dev</span>
      </span>
    </a>

    <div class="toolbar-context" data-context aria-live="polite"></div>

    {
      showQuick ? (
        <form class="quick" data-quick role="search">
          <input
            type="text"
            name="q"
            placeholder="Сура, 2:255 или слово…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Поиск: сура, аят или слово"
            data-quick-input
          />
          <button class="btn primary quick-submit" type="submit" aria-label="Перейти">→</button>
        </form>
      ) : (
        <div class="topbar-title">Поиск по Корану</div>
      )
    }

    <a class="icon-btn" href="/search" aria-label="Поиск" title="Поиск (/)" set:html={icons.search} />
    <a class="icon-btn desktop-comfort" href="/mushaf/1" aria-label="Мусхаф" title="Мусхаф" set:html={icons.book} />

    <!-- Перевод -->
    {showReaderTools && (
      <div class="menu-wrap desktop-only reader-tool" data-menu-wrap>
        <button class="btn" data-menu-toggle aria-haspopup="true">
          <span data-tr-current>Тафсир</span>
          <span set:html={icons.chevron} style="width:14px;height:14px" />
        </button>
        <div class="menu" data-menu="tr">
          <h4>Перевод / тафсир</h4>
          {
            TRANSLATIONS.map((t) => (
              <button
                class="item"
                type="button"
                data-tr={t.id}
                disabled={!t.available}
                title={t.available ? '' : 'Скоро'}
              >
                {t.name}
                {!t.available && <span style="color:var(--ink-faint);font-size:12px"> · скоро</span>}
                <span class="tick">✓</span>
              </button>
            ))
          }
        </div>
      </div>
    )}

    <!-- Чтец -->
    {showReaderTools && (
      <div class="menu-wrap desktop-only reader-tool" data-menu-wrap>
        <button class="icon-btn" data-menu-toggle aria-label="Чтец" title="Чтец" set:html={icons.headphones} />
        <div class="menu" data-menu="reciter">
          <h4>Чтец</h4>
          {
            reciters.map((r) => (
              <button class="item" type="button" data-reciter={r.id}>
                {r.name}
                <span class="tick">✓</span>
              </button>
            ))
          }
        </div>
      </div>
    )}

    <!-- Настройки чтения -->
    <div class="menu-wrap settings-menu-wrap" data-menu-wrap data-settings-menu-wrap>
      <button class="icon-btn" data-menu-toggle aria-label="Настройки чтения" title="Настройки" set:html={icons.settings} />
      <div class="menu" data-menu="settings" role="complementary" aria-label="Настройки чтения">
        <div class="settings-panel-head">
          <div>
            <strong>Настройки чтения</strong>
            <span>Вид, перевод, чтец и тема</span>
          </div>
          <button class="settings-panel-close" type="button" data-menu-close aria-label="Закрыть настройки" set:html={icons.close} />
        </div>

        <h4>Отображение</h4>
        <button class="item item-toggle" type="button" data-layer="ar">
          <span class="it-label">Арабский текст</span>
          <span class="switch" aria-hidden="true"></span>
        </button>
        <button class="item item-toggle" type="button" data-layer="tl">
          <span class="it-label">Транслитерация</span>
          <span class="switch" aria-hidden="true"></span>
        </button>
        <button class="item item-toggle" type="button" data-layer="tr">
          <span class="it-label">Перевод</span>
          <span class="switch" aria-hidden="true"></span>
        </button>

        <h4>Перевод / тафсир</h4>
        {
          TRANSLATIONS.map((t) => (
            <button class="item" type="button" data-tr={t.id} disabled={!t.available}>
              {t.name}
              {!t.available && <span style="color:var(--ink-faint);font-size:12px"> · скоро</span>}
              <span class="tick">✓</span>
            </button>
          ))
        }

        <h4>Показывать перевод</h4>
        <button class="item item-toggle" type="button" data-tr-show="kuliev">
          <span class="it-label">Эльмир Кулиев</span>
          <span class="switch" aria-hidden="true"></span>
        </button>
        <button class="item item-toggle" type="button" data-tr-show="abuadel">
          <span class="it-label">Абу Адель</span>
          <span class="switch" aria-hidden="true"></span>
        </button>

        <h4>Чтец</h4>
        <select class="sel" data-reciter-sel style="width:100%">
          {reciters.map((r) => <option value={r.id}>{r.name}</option>)}
        </select>

        <h4>Размер арабского</h4>
        <input type="range" min="22" max="52" step="2" data-set="ar" />
        <h4>Размер перевода</h4>
        <input type="range" min="14" max="26" step="1" data-set="ru" />
        <h4>Межстрочный интервал</h4>
        <input type="range" min="1.5" max="2.6" step="0.1" data-set="lh" />

        <h4>Шрифт арабского</h4>
        <div class="seg">
          {fonts.map((f) => <button type="button" data-font={f.id}>{f.label}</button>)}
        </div>

        <h4>Таджвид</h4>
        <button class="item item-toggle" type="button" data-tajweed>
          <span class="it-label">Цветные правила<small>Подсветка правил чтения (мадд, гунна, ихфа…)</small></span>
          <span class="switch" aria-hidden="true"></span>
        </button>
        <div class="tj-legend">
          <span><i class="tj-dot d-madd"></i>Мадд</span>
          <span><i class="tj-dot d-ghunna"></i>Гунна/идгам</span>
          <span><i class="tj-dot d-ikhfa"></i>Ихфа</span>
          <span><i class="tj-dot d-iqlab"></i>Икляб</span>
          <span><i class="tj-dot d-qalqala"></i>Калькаля</span>
          <span><i class="tj-dot d-silent"></i>Беззвучные</span>
        </div>

        <h4>Тема</h4>
        <div class="seg seg-grid2" data-theme-seg>
          {themes.map((t) => <button type="button" data-theme-set={t.id}>{t.label}</button>)}
        </div>

        <h4>Пояснения</h4>
        <button class="item item-toggle" type="button" data-hide-brackets>
          <span class="it-label">Скрыть скобки-пояснения</span>
          <span class="switch" aria-hidden="true"></span>
        </button>

        <h4>Заучивание</h4>
        <button class="item item-toggle" type="button" data-memorize>
          <span class="it-label">Режим заучивания<small>Скрыть перевод, повтор аята</small></span>
          <span class="switch" aria-hidden="true"></span>
        </button>
        <div class="seg" data-memrep-seg>
          <button type="button" data-memrep="2">×2</button>
          <button type="button" data-memrep="3">×3</button>
          <button type="button" data-memrep="5">×5</button>
          <button type="button" data-memrep="0">∞</button>
        </div>
      </div>
      <button class="settings-panel-backdrop" type="button" data-settings-panel-backdrop aria-label="Закрыть настройки"></button>
    </div>

    <!-- Тема: быстрый тумблер светлая/тёмная прямо в хедере (как в easybot).
         Полный выбор (сепия/системная) остаётся в панели «Настройки». -->
    <button
      class="icon-btn theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Переключить светлую и тёмную тему"
      title="Светлая / тёмная тема"
    >
      <span class="th-ic th-sun" set:html={icons.theme} />
      <span class="th-ic th-moon" set:html={'<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg>'} />
    </button>

    <!-- Закладки -->
    <div class="menu-wrap" data-menu-wrap>
      <button class="icon-btn" data-menu-toggle aria-label="Закладки" title="Закладки (B)" set:html={icons.bookmark} />
      <div class="menu" data-menu="bookmarks">
        <h4>Закладки</h4>
        <button class="item hide" type="button" data-bookmark-add>
          <span set:html={icons.bookmark} style="width:18px;height:18px" /> Добавить текущий аят
        </button>
        <div data-bookmark-list>
          <div style="padding:10px;color:var(--ink-faint);font-size:13px" data-bookmark-empty>
            Пока пусто. Открой аят и нажми на «флажок» или клавишу B.
          </div>
        </div>
      </div>
    </div>

    <!-- Продолжить (прячется на reader-страницах и мобиле) -->
    {!isReader && (
      <a class="btn ghost hide t-opt" data-continue href="#" title="Последнее место чтения">
        <span set:html={icons.continue} style="width:18px;height:18px" />
        <span class="desktop-only">Продолжить</span>
      </a>
    )}
  </div>
</header>

<script is:inline>
  // Контекст-заголовок тулбара: текущее «местоположение» (как в Finder/Preview).
  function qFillContext() {
    var el = document.querySelector('[data-context]');
    if (!el) return;
    var p = location.pathname;
    var t = '',
      s = '';
    var mush = p.match(/^\/mushaf\/(\d+)/);
    var body = document.body;
    if (mush) {
      t = 'Мусхаф';
      s = 'Страница ' + mush[1] + ' из 604';
    } else if (/^\/(surah|ayah)\//.test(p) || /^\/\d+:\d+/.test(p)) {
      var h1 = document.querySelector('.surah-head h1, h1');
      var sur = body.getAttribute('data-surah');
      var ay = body.getAttribute('data-ayah');
      t = (h1 && h1.textContent.trim()) || 'Сура';
      s = sur ? (ay ? sur + ':' + ay : 'Сура ' + sur) : '';
    } else if (p === '/search' || p.indexOf('/search') === 0) {
      t = 'Поиск';
    } else if (p.indexOf('/progress') === 0) {
      t = 'Мой прогресс';
    }
    if (t) el.innerHTML = '<span class="tc-t"></span><span class="tc-s"></span>';
    if (t) el.querySelector('.tc-t').textContent = t;
    if (s) el.querySelector('.tc-s').textContent = s;
    else if (t) el.querySelector('.tc-s').remove();
  }
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', qFillContext);
  else qFillContext();


  // ⌘, / Ctrl+, — открыть инспектор настроек (как в macOS-приложениях)
  document.addEventListener('keydown', function (e) {
    if ((e.metaKey || e.ctrlKey) && e.key === ',') {
      var btn = document.querySelector('[aria-label="Настройки чтения"]');
      if (btn) {
        e.preventDefault();
        btn.click();
      }
    }
  });
</script>

<style is:global>
  /* Тумблер темы в хедере: показываем иконку целевого режима —
     в тёмной теме солнце (клик → светлая), в светлой/сепии луну (клик → тёмная). */
  .theme-toggle {
    position: relative;
  }
  .theme-toggle .th-ic {
    display: none;
    align-items: center;
    justify-content: center;
  }
  .theme-toggle .th-ic svg {
    width: 20px;
    height: 20px;
  }
  html[data-theme='dark'] .theme-toggle .th-sun {
    display: inline-flex;
  }
  html[data-theme='light'] .theme-toggle .th-moon,
  html[data-theme='sepia'] .theme-toggle .th-moon {
    display: inline-flex;
  }
</style>
