---
// Список сур в боковом меню строится на клиенте из /data/index.json (app.ts initDrawer),
// чтобы не дублировать 114 ссылок в каждой из ~6.6k страниц.
import { icons } from '../lib/icons';
---

<div class="drawer-backdrop" data-drawer-backdrop></div>
<aside class="drawer" role="navigation" data-drawer data-dtab-active="surah" aria-label="Список сур и джузов">
  <div class="dh">
    <input type="text" placeholder="Поиск суры…" data-drawer-filter aria-label="Поиск суры" />
    <button type="button" class="icon-btn" data-act="drawer-close" aria-label="Закрыть" set:html={icons.close} />
  </div>
  <nav class="dgroup" aria-label="Чтение">
    <div class="dgroup-title">Чтение</div>
    <a data-continue href="/surah/1"><span class="di" set:html={icons.continue} />Продолжить</a>
    <a href="/progress"><span class="di" set:html={icons.study} />Мой прогресс</a>
  </nav>
  <div class="dtabs">
    <button type="button" class="on" data-dtab="surah">Суры</button>
    <button type="button" data-dtab="juz">Джузы</button>
  </div>
  <div class="drawer-progress" data-drawer-progress aria-label="Прогресс чтения"></div>
  <a class="drawer-progress-link" href="/progress">Мой прогресс: хатм, стрик, статистика →</a>
  <nav class="dlist" data-drawer-list></nav>
  <nav class="dlist djuz" data-drawer-juz aria-label="Джузы"></nav>
</aside>

<style>
  .drawer-progress-link {
    display: block;
    flex: none;
    margin: 8px 12px 6px;
    padding: 10px 12px;
    border-radius: var(--radius-s, 8px);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font: 600 var(--fs-13, 13px) / 1.2 var(--sans);
    text-align: center;
  }
  .drawer[data-dtab-active='juz'] .drawer-progress-link {
    display: none;
  }
</style>
