---
// Боковое меню (source list как в macOS): группы «Чтение» и «Разделы» + список
// сур/джузов. Список сур строится на клиенте из /data/index.json (app.ts initDrawer).
import { icons } from '../lib/icons';

const path = Astro.url.pathname;
const on = (p: string) =>
  path === p || (p !== '/' && p !== '/surah/1' && path.startsWith(p)) ? 'on' : '';

// иконки разделов, которых нет в lib/icons
const svgTopics =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h12M9 12h12M9 18h12"/><circle cx="4" cy="6" r="1.1"/><circle cx="4" cy="12" r="1.1"/><circle cx="4" cy="18" r="1.1"/></svg>';
const svgGlossary =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v18H6.5A1.5 1.5 0 0 1 5 19.5z"/><path d="M9 8h6M9 12h4"/></svg>';
const svgTasbih =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="3.5" r="1.7" fill="currentColor" stroke="none"/><path d="M12 8.5v3.7l2.5 1.6"/></svg>';
---

<div class="drawer-backdrop" data-drawer-backdrop></div>
<aside class="drawer sidebar" role="navigation" data-drawer data-dtab-active="surah" aria-label="Меню">
  <div class="dh">
    <input
      type="text"
      placeholder="Поиск суры…"
      data-drawer-filter
      aria-label="Поиск суры"
      inputmode="search"
      enterkeyhint="search"
      autocomplete="off"
    />
    <button type="button" class="icon-btn" data-act="drawer-close" aria-label="Закрыть" set:html={icons.close} />
  </div>

  <div class="dscroll">
    <nav class="dgroup" aria-label="Чтение">
      <div class="dgroup-title">Чтение</div>
      <a class={on('/progress')} href="/progress" aria-current={on('/progress') ? 'page' : undefined}>
        <span class="di" set:html={icons.study} />Мой прогресс
      </a>
      <a class={on('/bookmarks')} href="/bookmarks" aria-current={on('/bookmarks') ? 'page' : undefined}>
        <span class="di" set:html={icons.bookmark} />Закладки
      </a>
      <a data-continue href="/surah/1">
        <span class="di" set:html={icons.continue} />Продолжить
      </a>
    </nav>

    <nav class="dgroup" aria-label="Разделы">
      <div class="dgroup-title">Разделы</div>
      <a class={on('/mushaf')} href="/mushaf/1" aria-current={on('/mushaf') ? 'page' : undefined}>
        <span class="di" set:html={icons.book} />Мусхаф
      </a>
      <a class={on('/topics')} href="/topics" aria-current={on('/topics') ? 'page' : undefined}>
        <span class="di" set:html={svgTopics} />Аяты по темам
      </a>
      <a class={on('/glossary')} href="/glossary" aria-current={on('/glossary') ? 'page' : undefined}>
        <span class="di" set:html={svgGlossary} />Словарь терминов
      </a>
      <a class={on('/tasbih')} href="/tasbih" aria-current={on('/tasbih') ? 'page' : undefined}>
        <span class="di" set:html={svgTasbih} />Тасбих
      </a>
      <a class={on('/search')} href="/search" aria-current={on('/search') ? 'page' : undefined}>
        <span class="di" set:html={icons.search} />Поиск по Корану
      </a>
    </nav>

    <div class="dgroup-title dgt-list">Суры Корана</div>
    <div class="dtabs">
      <button type="button" class="on" data-dtab="surah">Суры</button>
      <button type="button" data-dtab="juz">Джузы</button>
    </div>
    <div class="drawer-progress" data-drawer-progress aria-label="Прогресс чтения"></div>
    <nav class="dlist" data-drawer-list></nav>
    <nav class="dlist djuz" data-drawer-juz aria-label="Джузы"></nav>
  </div>

  <div class="dfoot">
    <a class={on('/backup')} href="/backup" aria-current={on('/backup') ? 'page' : undefined}>
      <span class="di" set:html={icons.download} />Резервная копия
    </a>
    <a class={on('/about')} href="/about">
      <span class="di" set:html={icons.details} />О проекте
    </a>
  </div>
</aside>

<style is:global>
  /* ---- Боковое меню в стиле macOS source list ---- */
  .drawer.sidebar {
    display: flex;
    flex-direction: column;
  }
  .drawer .dscroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: 6px;
  }
  .drawer .dgroup {
    padding: 4px 10px;
  }
  .drawer .dgroup-title {
    font: var(--weight-semibold) var(--fs-11) / 1 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 10px 6px 6px;
  }
  .drawer .dgt-list {
    margin-top: 6px;
    padding: 0 10px;
  }
  .drawer .dgroup a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 9px;
    border-radius: var(--radius-s);
    color: var(--ink);
    font: 500 var(--fs-14) / 1.2 var(--sans);
    text-decoration: none;
    transition: background 0.12s;
  }
  .drawer .dgroup a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .drawer .dgroup a.on {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .drawer .dgroup a.on .di {
    color: var(--accent-ink);
    opacity: 0.9;
  }
  .drawer .dgroup a .di {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--ink-faint);
    display: inline-flex;
  }
  .drawer .dgroup a .di svg {
    width: 100%;
    height: 100%;
  }
  /* подвал меню — прижат вниз, отделён линией */
  .drawer .dfoot {
    flex: none;
    border-top: 1px solid var(--hairline);
    padding: 6px 10px;
    display: grid;
    gap: 2px;
  }
  .drawer .dfoot a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 9px;
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font: 500 var(--fs-13) / 1.2 var(--sans);
    text-decoration: none;
  }
  .drawer .dfoot a:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--ink);
  }
  .drawer .dfoot a.on {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .drawer .dfoot a.on .di {
    color: var(--accent-ink);
  }
  .drawer .dfoot a .di {
    width: 17px;
    height: 17px;
    flex: none;
    color: var(--ink-faint);
    display: inline-flex;
  }
  .drawer .dfoot a .di svg {
    width: 100%;
    height: 100%;
  }
  .drawer[data-dtab-active='juz'] .drawer-progress {
    display: none;
  }
  .drawer .dscroll .dlist {
    flex: none;
    min-height: 0;
    overflow: visible;
    padding: 2px 6px 6px;
  }
  .drawer .dgroup a:focus-visible,
  .drawer .dfoot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  /* Десктоп: сайдбар постоянный и сворачивается гамбургером в тулбаре —
     крестик «закрыть» в шапке лишний (висел справа от поиска). Убираем его,
     поле поиска занимает всю ширину шапки. */
  @media (min-width: 1120px) {
    .drawer .dh [data-act='drawer-close'] {
      display: none !important;
    }
    .drawer .dh {
      gap: 0;
    }
  }

  @media (max-width: 820px) {
    .drawer {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: min(100%, 440px);
      height: min(86dvh, calc(100dvh - max(18px, env(safe-area-inset-top))));
      max-height: calc(100dvh - max(18px, env(safe-area-inset-top)));
      margin-inline: auto;
      border-radius: 24px 24px 0 0;
      overflow: hidden;
      transform: translateY(105%);
      transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .drawer.show {
      transform: translateY(0);
    }
    .drawer::before {
      content: '';
      flex: none;
      width: 42px;
      height: 4px;
      border-radius: 999px;
      background: var(--line);
      margin: 10px auto 2px;
      opacity: 0.9;
    }
    .drawer .dh {
      flex: none;
      padding: 10px 14px 12px;
      border-bottom: 1px solid var(--hairline);
    }
    .drawer .dh input {
      height: 44px;
      border-radius: 14px;
    }
    .drawer .dscroll {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 10px;
      touch-action: pan-y;
    }
    .drawer .dgroup {
      padding-inline: 12px;
    }
    .drawer .dfoot {
      flex: none;
      padding: 8px 14px calc(12px + env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--panel-bg) 92%, transparent);
    }
  }
</style>
