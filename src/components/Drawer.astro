---
// Боковое меню (source list как в macOS): группы «Чтение» и «Разделы» + список
// сур/джузов. Список сур строится на клиенте из /data/index.json (app.ts initDrawer).
import { icons } from '../lib/icons';
import IconButton from './ui/IconButton.astro';
import ListRow from './ui/ListRow.astro';
import SegmentedControl from './ui/SegmentedControl.astro';

const path = Astro.url.pathname;
const on = (p: string) =>
  path === p || (p !== '/' && p !== '/surah/1' && path.startsWith(p)) ? 'on' : '';

// иконки разделов, которых нет в lib/icons
const svgTopics =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h12M9 12h12M9 18h12"/><circle cx="4" cy="6" r="1.1"/><circle cx="4" cy="12" r="1.1"/><circle cx="4" cy="18" r="1.1"/></svg>';
const svgGlossary =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v18H6.5A1.5 1.5 0 0 1 5 19.5z"/><path d="M9 8h6M9 12h4"/></svg>';
const svgTasbih =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="3.5" r="1.7" fill="currentColor" stroke="none"/><path d="M12 8.5v3.7l2.5 1.6"/></svg>';
---

<div class="drawer-backdrop" data-drawer-backdrop></div>
<aside class="drawer sidebar" role="navigation" data-drawer data-dtab-active="surah" aria-label="Меню">
  <div class="dh">
    <input
      type="text"
      placeholder="Поиск суры…"
      data-drawer-filter
      aria-label="Поиск суры"
      inputmode="search"
      enterkeyhint="search"
      autocomplete="off"
    />
    <IconButton label="Закрыть" data-act="drawer-close" set:html={icons.close} />
  </div>

  <div class="dscroll">
    <nav class="dgroup" aria-label="Чтение">
      <div class="dgroup-title">Чтение</div>
      <ListRow class={on('/progress')} href="/progress" aria-current={on('/progress') ? 'page' : undefined}>
        <span class="di" set:html={icons.study} />Мой прогресс
      </ListRow>
      <ListRow class={on('/bookmarks')} href="/bookmarks" aria-current={on('/bookmarks') ? 'page' : undefined}>
        <span class="di" set:html={icons.bookmark} />Закладки
      </ListRow>
      <ListRow data-continue href="/surah/1">
        <span class="di" set:html={icons.continue} />Продолжить
      </ListRow>
    </nav>

    <nav class="dgroup" aria-label="Разделы">
      <div class="dgroup-title">Разделы</div>
      <ListRow class={on('/mushaf')} href="/mushaf/1" aria-current={on('/mushaf') ? 'page' : undefined}>
        <span class="di" set:html={icons.book} />Мусхаф
      </ListRow>
      <ListRow class={on('/topics')} href="/topics" aria-current={on('/topics') ? 'page' : undefined}>
        <span class="di" set:html={svgTopics} />Аяты по темам
      </ListRow>
      <ListRow class={on('/glossary')} href="/glossary" aria-current={on('/glossary') ? 'page' : undefined}>
        <span class="di" set:html={svgGlossary} />Словарь терминов
      </ListRow>
      <ListRow class={on('/tasbih')} href="/tasbih" aria-current={on('/tasbih') ? 'page' : undefined}>
        <span class="di" set:html={svgTasbih} />Тасбих
      </ListRow>
      <ListRow class={on('/search')} href="/search" aria-current={on('/search') ? 'page' : undefined}>
        <span class="di" set:html={icons.search} />Поиск по Корану
      </ListRow>
    </nav>

    <div class="dgroup-title dgt-list">Суры Корана</div>
    <SegmentedControl
      class="dtabs"
      options={[
        { id: 'surah', label: 'Суры', selected: true },
        { id: 'juz', label: 'Джузы' },
      ]}
      dataAttr="data-dtab"
      ariaLabel="Список в меню"
    />
    <div class="drawer-progress" data-drawer-progress aria-label="Прогресс чтения"></div>
    <nav class="dlist" data-drawer-list></nav>
    <nav class="dlist djuz" data-drawer-juz aria-label="Джузы"></nav>
  </div>

  <div class="dfoot">
    <ListRow class={on('/backup')} href="/backup" aria-current={on('/backup') ? 'page' : undefined}>
      <span class="di" set:html={icons.download} />Резервная копия
    </ListRow>
    <ListRow class={on('/about')} href="/about">
      <span class="di" set:html={icons.details} />О проекте
    </ListRow>
  </div>
</aside>
