---
import IconButton from './ui/IconButton.astro';
import Toolbar from './ui/Toolbar.astro';
import { icons } from '../lib/icons';
---

<div class="player" data-player aria-label="Аудиоплеер">
  <Toolbar class="player-inner ui-player-toolbar" label="Аудиоплеер">
    <div class="now">
      <div class="t" data-player-title>Аят не выбран</div>
      <div class="s" data-player-sub>Выберите аят кнопкой ▶</div>
    </div>

    <div class="ctrls">
      <IconButton label="Предыдущий аят" title="Пред. ([)" data-player-prev set:html={icons.prev} />
      <IconButton label="Воспроизвести/пауза" title="Play/pause (P)" class="play" data-player-toggle set:html={icons.play} />
      <IconButton label="Следующий аят" title="След. (])" data-player-next set:html={icons.next} />
    </div>

    <div class="extra">
      <IconButton label="Повтор аята" title="Повтор аята" data-player-repeat set:html={icons.repeat} />
      <IconButton label="Повтор диапазона" title="Повтор диапазона" class="desktop-only" data-player-range set:html={icons.repeatRange} />
      <IconButton label="Скорость" title="Скорость воспроизведения" data-player-speed>
        <span class="speed" data-player-speed-label>1×</span>
      </IconButton>
      <IconButton label="Скрыть плеер" class="desktop-only" data-player-close set:html={icons.close} />
    </div>
  </Toolbar>
  <audio data-player-audio preload="none"></audio>
</div>
