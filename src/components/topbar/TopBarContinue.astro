---
import { icons } from '../../lib/icons';
interface Props {
  isReader: boolean;
}
const { isReader } = Astro.props;
---

<!-- Продолжить (прячется на reader-страницах и мобиле) -->
{!isReader && (
  <a class="btn ghost hide t-opt" data-continue href="#" title="Последнее место чтения">
    <span set:html={icons.continue} style="width:18px;height:18px" />
    <span class="desktop-only">Продолжить</span>
  </a>
)}
