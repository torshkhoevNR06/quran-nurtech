---
import { icons } from '../../lib/icons';
import { getReciters, TRANSLATIONS } from '../../lib/quran';
const reciters = getReciters();
const fonts = [
  { id: 'Mushaf', label: 'Мусхаф' },
  { id: 'AmiriQuran', label: 'Амири' },
  { id: 'NaskhAr', label: 'Насх' },
];
const themes = [
  { id: 'light', label: 'Светлая' },
  { id: 'dark', label: 'Тёмная' },
  { id: 'sepia', label: 'Сепия' },
  { id: 'system', label: 'Системная' },
];
---

<!-- Настройки чтения -->
<div class="menu-wrap settings-menu-wrap" data-menu-wrap data-settings-menu-wrap>
  <button class="icon-btn" data-menu-toggle data-settings-toggle aria-label="Настройки чтения" title="Настройки" set:html={icons.settings} />
  <div class="menu" data-menu="settings" role="complementary" aria-label="Настройки чтения">
    <div class="settings-panel-head">
      <div>
        <strong>Настройки чтения</strong>
        <span>Текст, перевод, звук и оформление</span>
      </div>
      <button class="settings-panel-close" type="button" data-menu-close aria-label="Закрыть настройки" set:html={icons.close} />
    </div>

    <div class="settings-panel-body">
      <section class="settings-section">
        <div class="settings-section-head">
          <span>Содержание</span>
          <small>Слои текста в аяте</small>
        </div>
        <div class="settings-group">
          <button class="item item-toggle settings-row" type="button" data-layer="ar">
            <span class="it-label">Арабский текст</span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <button class="item item-toggle settings-row" type="button" data-layer="tr">
            <span class="it-label">Перевод</span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <button class="item item-toggle settings-row" type="button" data-layer="tl">
            <span class="it-label">Транслитерация</span>
            <span class="switch" aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section class="settings-section">
        <div class="settings-section-head">
          <span>Перевод и тафсир</span>
          <small>Основной источник</small>
        </div>
        <div class="settings-choice-list">
          {
            TRANSLATIONS.map((t) => (
              <button class="item settings-choice" type="button" data-tr={t.id} disabled={!t.available}>
                <span class="settings-choice-label">
                  {t.name}
                  {!t.available && <small>скоро</small>}
                </span>
                <span class="tick">✓</span>
              </button>
            ))
          }
        </div>
        <div class="settings-group settings-group-compact">
          <button class="item item-toggle settings-row" type="button" data-tr-show="kuliev">
            <span class="it-label">Показывать Кулиева</span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <button class="item item-toggle settings-row" type="button" data-tr-show="abuadel">
            <span class="it-label">Показывать Абу Аделя</span>
            <span class="switch" aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section class="settings-section">
        <div class="settings-section-head">
          <span>Аудио</span>
          <small>Голос для прослушивания</small>
        </div>
        <label class="settings-field settings-field-select">
          <span>Чтец</span>
          <select class="sel" data-reciter-sel>
            {reciters.map((r) => <option value={r.id}>{r.name}</option>)}
          </select>
        </label>
      </section>

      <section class="settings-section">
        <div class="settings-section-head">
          <span>Типографика</span>
          <small>Размеры и арабский шрифт</small>
        </div>
        <div class="settings-group settings-sliders">
          <label class="settings-field settings-field-range">
            <span>Арабский</span>
            <input type="range" min="22" max="52" step="2" data-set="ar" />
          </label>
          <label class="settings-field settings-field-range">
            <span>Перевод</span>
            <input type="range" min="14" max="26" step="1" data-set="ru" />
          </label>
          <label class="settings-field settings-field-range">
            <span>Интервал</span>
            <input type="range" min="1.5" max="2.6" step="0.1" data-set="lh" />
          </label>
        </div>
        <div class="settings-field settings-field-stack">
          <span>Шрифт арабского</span>
          <div class="seg">
            {fonts.map((f) => <button type="button" data-font={f.id}>{f.label}</button>)}
          </div>
        </div>
      </section>

      <section class="settings-section">
        <div class="settings-section-head">
          <span>Оформление</span>
          <small>Тема и правила чтения</small>
        </div>
        <div class="settings-group">
          <button class="item item-toggle settings-row" type="button" data-tajweed>
            <span class="it-label">Таджвид<small>Цветные правила чтения</small></span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <div class="tj-legend">
            <span><i class="tj-dot d-madd"></i>Мадд</span>
            <span><i class="tj-dot d-ghunna"></i>Гунна</span>
            <span><i class="tj-dot d-ikhfa"></i>Ихфа</span>
            <span><i class="tj-dot d-iqlab"></i>Икляб</span>
            <span><i class="tj-dot d-qalqala"></i>Калькаля</span>
            <span><i class="tj-dot d-silent"></i>Беззвучные</span>
          </div>
        </div>
        <div class="settings-field settings-field-stack">
          <span>Тема</span>
          <div class="seg seg-grid2" data-theme-seg>
            {themes.map((t) => <button type="button" data-theme-set={t.id}>{t.label}</button>)}
          </div>
        </div>
      </section>

      <section class="settings-section">
        <div class="settings-section-head">
          <span>Режимы чтения</span>
          <small>Поведение текста</small>
        </div>
        <div class="settings-group">
          <button class="item item-toggle settings-row" type="button" data-hide-brackets>
            <span class="it-label">Скрыть пояснения в скобках</span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <button class="item item-toggle settings-row" type="button" data-memorize>
            <span class="it-label">Заучивание<small>Скрыть перевод и повторять аят</small></span>
            <span class="switch" aria-hidden="true"></span>
          </button>
        </div>
        <div class="settings-field settings-field-stack">
          <span>Повтор аята</span>
          <div class="seg" data-memrep-seg>
            <button type="button" data-memrep="2">×2</button>
            <button type="button" data-memrep="3">×3</button>
            <button type="button" data-memrep="5">×5</button>
            <button type="button" data-memrep="0">∞</button>
          </div>
        </div>
      </section>
    </div>
  </div>
  <button class="settings-panel-backdrop" type="button" data-settings-panel-backdrop aria-label="Закрыть настройки"></button>
</div>

