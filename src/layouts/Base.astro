import TopBar from '../components/TopBar.astro';
import Drawer from '../components/Drawer.astro';
import Player from '../components/Player.astro';
import { icons } from '../lib/icons';

export interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  pageMode?: string;
  /** для страниц суры/аята — чтобы плеер знал контекст */
  surahId?: number;
  ayahId?: number;
  tr?: string;
}

const { title, description, wide = false, pageMode, surahId, ayahId, tr } = Astro.props;
const desc =
  description ??
  'Коран онлайн на русском языке: чтение, перевод, тафсир ас-Саади, аудио чтецов, поиск и заучивание. 114 сур, 6236 аятов.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const tab = (name: 'home' | 'read' | 'mushaf' | 'search') => {
  if (name === 'home') return path === '/' ? 'active' : '';
  if (name === 'read') return path.startsWith('/surah') || path.startsWith('/ayah') || /^\/\d+:\d+/.test(path) ? 'active' : '';
  if (name === 'mushaf') return path.startsWith('/mushaf') ? 'active' : '';
  if (name === 'search') return path.startsWith('/search') ? 'active' : '';
  return '';
};
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Коран онлайн" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#3f4a58" />
    <link rel="icon" href="/favicon.png?v=g2" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=g2" />
    <link rel="preload" href="/brand-mark.png?v=g2" as="image" fetchpriority="high" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Коран" />
    <link rel="preload" href="/fonts/kfgqpc-hafs.woff2" as="font" type="font/woff2" crossorigin />
    <!-- анти-flash: тема и настройки чтения до первой отрисовки -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('q_theme');
          var t = 'system';
          if (raw) {
            try {
              t = JSON.parse(raw);
            } catch (e) {
              t = raw;
            }
          }
          var eff = t;
          if (t === 'system')
            eff = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', eff);
          var r = JSON.parse(localStorage.getItem('q_read') || '{}');
          var el = document.documentElement.style;
          if (r.ar) el.setProperty('--ar-size', r.ar + 'px');
          if (r.ru) el.setProperty('--ru-size', r.ru + 'px');
          if (r.lh) el.setProperty('--lh', r.lh);
          if (r.font) el.setProperty('--ar-font', r.font);
          if (/^(\/surah\/|\/ayah\/|\/\d+:\d+)/.test(location.pathname)) {
            var layers = JSON.parse(localStorage.getItem('q_layers') || '{}');
            layers.ar = layers.ar !== false;
            layers.tr = layers.tr !== false;
            layers.tl = true;
            localStorage.setItem('q_layers', JSON.stringify(layers));
          }
          var plainSurah = location.pathname.match(/^\/surah\/(\d+)\/?$/);
          if (plainSurah) {
            var savedTr = localStorage.getItem('q_tr');
            if (savedTr) {
              try {
                savedTr = JSON.parse(savedTr);
              } catch (e) {}
            }
            if (/^(abuadel|saadi|ibn-kathir)$/.test(savedTr || '')) {
              location.replace('/surah/' + plainSurah[1] + '/' + savedTr);
              return;
            }
          }
          var sidebar = localStorage.getItem('q_sidebar');
          if (sidebar === 'open') localStorage.setItem('q_sidebar', 'closed');
          document.documentElement.setAttribute('data-sidebar', 'closed');
          if (/^\/mushaf\/\d+/.test(location.pathname)) {
            var vw = Math.max(320, window.innerWidth || 0);
            var vh = Math.max(360, window.innerHeight || 0);
            var mobile = vw <= 650;
            var availableWidth = vw - (mobile ? 56 : 88);
            var availableHeight = vh - (mobile ? 152 : vw >= 900 ? 225 : 246);
            var maxWidth = mobile ? 620 : 760;
            var pageWidth = Math.floor(Math.min(availableWidth, availableHeight * 0.704, maxWidth));
            pageWidth = Math.max(1, pageWidth);
            el.setProperty('--mushaf-vvh', vh + 'px');
            el.setProperty('--mushaf-page-w', pageWidth + 'px');
            el.setProperty('--mushaf-page-zoom', '1');
            el.setProperty('--mushaf-qcf-fit', '1');
            var qcfRatio = mobile ? 0.05 : 0.052;
            var qcfMin = mobile ? 12.5 : 20;
            var qcfMax = mobile ? 29 : 44;
            el.setProperty('--mushaf-qcf-size', Math.max(qcfMin, Math.min(qcfMax, pageWidth * qcfRatio)).toFixed(2) + 'px');
          }
        } catch (e) {}
      })();
    </script>
    <!-- PWA: офлайн-доступ -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        (function () {
          var isLocal = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
          if (isLocal) {
            addEventListener('load', function () {
              Promise.all([
                navigator.serviceWorker.getRegistrations().then(function (registrations) {
                  return Promise.all(registrations.map(function (registration) {
                    return registration.unregister();
                  }));
                }),
                'caches' in window
                  ? caches.keys().then(function (keys) {
                      return Promise.all(keys.map(function (key) { return caches.delete(key); }));
                    })
                  : Promise.resolve(),
              ]).then(function () {
                if (navigator.serviceWorker.controller && !sessionStorage.getItem('q_local_sw_reset')) {
                  sessionStorage.setItem('q_local_sw_reset', '1');
                  location.reload();
                } else {
                  sessionStorage.removeItem('q_local_sw_reset');
                }
              }).catch(function () {});
            });
            return;
          }
          addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js?v=mushaf-css-immersive-5').catch(function () {});
          });
        })();
      }
    </script>
  </head>
  <body data-surah={surahId ?? ''} data-ayah={ayahId ?? ''} data-tr={tr ?? ''} data-page-mode={pageMode ?? ''}>
    <TopBar />
    <main role="main" class={wide ? 'wide' : ''}>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="fnav">
          <a href="/">Главная</a>
          <a href="/mushaf/1">Мусхаф</a>
          <a href="/progress">Мой прогресс</a>
          <a href="/bookmarks">Закладки</a>
          <a href="/topics">Аяты по темам</a>
          <a href="/glossary">Словарь</a>
          <a href="/tasbih">Тасбих</a>
          <a href="/backup">Резервная копия</a>
          <a href="/search">Поиск</a>
          <a href="/audio">Аудио</a>
          <a href="/videos">Видео</a>
          <a href="/stats">Статистика</a>
          <a href="/download">Скачать</a>
          <a href="/howto">Как работать</a>
          <a href="/about">О проекте</a>
          <a href="/translators">Переводчики</a>
          <a href="/privacy">Конфиденциальность</a>
        </div>
        <div>
          Коран онлайн — quran.nurtech.dev. Тексты и аудио из открытых источников (см.
          <a class="link" href="/about" style="color:var(--accent)">О проекте</a>).
        </div>
      </div>
    </footer>

    <Drawer />
    <Player />
    <nav class="mobile-tabbar" aria-label="Основная навигация">
      <a class={tab('home')} href="/" aria-label="Главная">
        <span set:html={icons.home}></span>
        <b>Главная</b>
      </a>
      <a class={tab('read')} href="/surah/1" aria-label="Читать">
        <span set:html={icons.book}></span>
        <b>Читать</b>
      </a>
      <a class={tab('mushaf')} href="/mushaf/1" aria-label="Мусхаф">
        <span set:html={icons.book}></span>
        <b>Мусхаф</b>
      </a>
      <a class={tab('search')} href="/search" aria-label="Поиск">
        <span set:html={icons.search}></span>
        <b>Поиск</b>
      </a>
      <button type="button" data-act="drawer" aria-label="Меню">
        <span set:html={icons.menu}></span>
        <b>Меню</b>
      </button>
    </nav>
    <div class="toast" id="toast"></div>

    <script>
      import '../client/app';
    </script>
  </body>
</html>
