---
import Base from '../layouts/Base.astro';
import { icons } from '../lib/icons';
const title = 'Аудио Корана — чтецы, суры, скачивание';
const description = 'Слушайте и скачивайте аудио Корана: чтецы (Мишари Рашид, аль-Хусари, аль-Катами и другие), выбор суры и аята, повтор, скорость.';
---

<Base {title} {description}>
  <div class="container page audio-page">
    <header class="page-head">
      <p class="eyebrow">Слушание и заучивание</p>
      <h1>Аудио Корана</h1>
      <p>Выберите чтеца и суру. Можно слушать по аятам, повторять текущий аят, менять скорость и скачивать mp3.</p>
    </header>

    <div class="audio-selectors">
      <label>
        <span>Чтец</span>
        <select class="sel" data-audio-reciter aria-label="Чтец"></select>
      </label>
      <label>
        <span>Сура</span>
        <select class="sel" data-audio-surah aria-label="Сура"></select>
      </label>
    </div>

    <section class="audio-now" aria-label="Текущий аят">
      <div class="now">
        <div class="eyebrow" data-a-progress>Выберите аят</div>
        <div class="t" data-a-title>Аят не выбран</div>
        <div class="s" data-a-sub>Нажмите play в списке ниже или большую кнопку воспроизведения.</div>
      </div>
      <div class="audio-controls">
        <button class="icon-btn" data-a-prev aria-label="Предыдущий" set:html={icons.prev} />
        <button class="play audio-main-play" data-a-toggle aria-label="Play/pause" set:html={icons.play} />
        <button class="icon-btn" data-a-next aria-label="Следующий" set:html={icons.next} />
        <button class="icon-btn" data-a-repeat aria-label="Повтор аята" title="Повтор аята" set:html={icons.repeat} />
        <button class="icon-btn" data-a-speed aria-label="Скорость"><span class="speed" data-a-speed-label>1×</span></button>
      </div>
      <audio data-a-audio preload="none"></audio>
    </section>

    <div class="audio-list" data-a-rows></div>
  </div>

  <script>
    import '../client/audio';
  </script>
</Base>
