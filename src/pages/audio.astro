---
import Base from '../layouts/Base.astro';
import IconButton from '../components/ui/IconButton.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageShell from '../components/ui/PageShell.astro';
import { icons } from '../lib/icons';
const title = 'Аудио Корана — чтецы, суры, скачивание';
const description = 'Слушайте и скачивайте аудио Корана: чтецы (Мишари Рашид, аль-Хусари, аль-Катами и другие), выбор суры и аята, повтор, скорость.';
---

<Base {title} {description}>
  <PageShell class="audio-page">
    <PageHeader
      kicker="Слушание и заучивание"
      title="Аудио Корана"
      description="Выберите чтеца и суру. Можно слушать по аятам, повторять текущий аят, менять скорость и скачивать mp3."
    />

    <div class="audio-selectors">
      <label>
        <span>Чтец</span>
        <select class="sel" data-audio-reciter aria-label="Чтец"></select>
      </label>
      <label>
        <span>Сура</span>
        <select class="sel" data-audio-surah aria-label="Сура"></select>
      </label>
    </div>

    <section class="audio-now" aria-label="Текущий аят">
      <div class="now">
        <div class="eyebrow" data-a-progress>Выберите аят</div>
        <div class="t" data-a-title>Аят не выбран</div>
        <div class="s" data-a-sub>Нажмите play в списке ниже или большую кнопку воспроизведения.</div>
      </div>
      <div class="audio-controls">
        <IconButton label="Предыдущий" data-a-prev><span set:html={icons.prev} /></IconButton>
        <button class="play audio-main-play" data-a-toggle aria-label="Play/pause" set:html={icons.play} />
        <IconButton label="Следующий" data-a-next><span set:html={icons.next} /></IconButton>
        <IconButton label="Повтор аята" title="Повтор аята" data-a-repeat><span set:html={icons.repeat} /></IconButton>
        <IconButton label="Скорость" data-a-speed><span class="speed" data-a-speed-label>1×</span></IconButton>
      </div>
      <audio data-a-audio preload="none"></audio>
    </section>

    <div class="audio-list" data-a-rows></div>
  </PageShell>

  <script>
    import '../client/audio';
  </script>
</Base>
