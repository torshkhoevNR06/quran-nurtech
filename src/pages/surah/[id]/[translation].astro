---
import Base from '../../../layouts/Base.astro';
import SurahView from '../../../components/SurahView.astro';
import { getSurahs, getSurahMeta, TRANSLATIONS } from '../../../lib/quran';

export function getStaticPaths() {
  const avail = TRANSLATIONS.filter((t) => t.available).map((t) => t.id); // saadi, kuliev
  const paths = [];
  for (const s of getSurahs()) {
    for (const tr of avail) {
      paths.push({ params: { id: String(s.n), translation: tr } });
    }
  }
  return paths;
}

const id = Number(Astro.params.id);
const translation = Astro.params.translation as 'saadi' | 'kuliev';
const meta = getSurahMeta(id)!;
const trName = translation === 'saadi' ? 'тафсир ас-Саади' : 'перевод Кулиева';
const title = `Сура ${id}: ${meta.nr} — ${trName}`;
const description = `Сура «${meta.nr}» (${meta.nm}), ${meta.c} аятов. Арабский текст и ${trName}. Аудио, поиск, закладки.`;
---

<Base {title} {description} surahId={id} tr={translation}>
  <SurahView surahId={id} {translation} />
</Base>
