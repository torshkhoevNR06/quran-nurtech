---
import Base from '../../../layouts/Base.astro';
import SurahView from '../../../components/SurahView.astro';
import type { TranslationId } from '../../../components/SurahView.astro';
import { getSurahs, getSurahMeta, TRANSLATIONS } from '../../../lib/quran';

export function getStaticPaths() {
  const avail = TRANSLATIONS.filter((t) => t.available).map((t) => t.id); // kuliev, abuadel, saadi, ibn-kathir
  const paths = [];
  for (const s of getSurahs()) {
    for (const tr of avail) {
      paths.push({ params: { id: String(s.n), translation: tr } });
    }
  }
  return paths;
}

const id = Number(Astro.params.id);
const translation = Astro.params.translation as TranslationId;
const meta = getSurahMeta(id)!;
const trName = (TRANSLATIONS.find((t) => t.id === translation)?.name || 'перевод').toLowerCase();
const title = `Сура ${id}: ${meta.nr} — ${trName}`;
const description = `Сура «${meta.nr}» (${meta.nm}), ${meta.c} аятов. Арабский текст и ${trName}. Аудио, поиск, закладки.`;
// Переводы (Кулиев/Абу Адель) — с ленивым тафсиром под аятом; тафсиры (ас-Саади/
// Ибн Касир) как выделенные роуты печатаются сплошным «полным чтением».
const inlineTafsir = translation !== 'saadi' && translation !== 'ibn-kathir';
---

<Base {title} {description} surahId={id} tr={translation}>
  <SurahView surahId={id} {translation} inlineTafsir={inlineTafsir} />
</Base>
