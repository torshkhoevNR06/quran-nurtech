---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageShell from '../components/ui/PageShell.astro';
const title = 'Как работать с сайтом — Коран онлайн';
const description = 'Инструкция: быстрый переход, режимы отображения, аудио, закладки, темы, горячие клавиши.';
const keys = [
  ['[', 'предыдущий аят'],
  [']', 'следующий аят'],
  ['Shift + [', 'назад на 10 аятов'],
  ['Shift + ]', 'вперёд на 10 аятов'],
  ['Alt + [', 'предыдущая сура'],
  ['Alt + ]', 'следующая сура'],
  ['A', 'арабский текст'],
  ['S', 'перевод'],
  ['T', 'тафсир'],
  ['P', 'play / пауза'],
  ['/', 'фокус в поиск/переход'],
  ['B', 'закладка текущего аята'],
];
---

<Base {title} {description}>
  <PageShell>
    <PageHeader title="Как работать с сайтом" />

    <h2>Быстрый переход</h2>
    <p>Поле вверху принимает: номер суры (<b>18</b>), номер аята (<b>2:255</b>), название (<b>ясин</b>, <b>аль-кахф</b>). Нажмите Enter — откроется нужное место.</p>

    <h2>Режимы отображения</h2>
    <p>Переключатель «Араб / Перевод / Тафсир / Всё» меняет, что показывать в суре. Выбор сохраняется.</p>

    <h2>Перевод и чтец</h2>
    <p>В верхней панели выбираются перевод/тафсир и чтец. Страница суры открывается по адресу вида <b>/surah/2/saadi</b> или <b>/surah/2/kuliev</b>.</p>

    <h2>Аудио</h2>
    <p>Нажмите ▶ у аята — внизу появится плеер: предыдущий/следующий аят, повтор аята, повтор диапазона, скорость 0.75× / 1× / 1.25× / 1.5×. Каталог чтецов и скачивание — на странице <a class="link" href="/audio" style="color:var(--accent)">Аудио</a>.</p>

    <h2>Закладки и «Продолжить»</h2>
    <p>«Флажок» у аята добавляет закладку. Кнопка «Продолжить» возвращает к последнему прочитанному месту. Всё хранится локально в браузере — без регистрации.</p>

    <h2>Темы и шрифт</h2>
    <p>Тема: светлая, тёмная, сепия или системная. В настройках чтения — размер арабского и русского текста, межстрочный интервал и арабский шрифт.</p>

    <h2>Горячие клавиши</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;margin-top:8px">
      {keys.map(([k, v]) => (
        <div style="display:flex;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);padding:8px 12px">
          <kbd style="font: var(--weight-semibold) 12px/1 var(--sans);background:var(--surface-2);border:1px solid var(--line);border-radius:6px;padding:4px 8px">{k}</kbd>
          <span style="color:var(--ink-soft)">{v}</span>
        </div>
      ))}
    </div>
  </PageShell>
</Base>
