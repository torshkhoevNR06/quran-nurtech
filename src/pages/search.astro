---
import Base from '../layouts/Base.astro';
import { icons } from '../lib/icons';
const title = 'Поиск по Корану — по русскому переводу';
const description = 'Поиск по Корану на русском языке (перевод Кулиева). Фильтр по суре, точное и частичное совпадение, ссылки на аяты.';
---

<Base {title} {description}>
  <div class="container page">
    <h1>Поиск по Корану</h1>
    <p>Поиск по русскому переводу (Эльмир Кулиев). Введите слово или фразу.</p>

    <form data-search-form style="display:flex;gap:8px;flex-wrap:wrap;margin:16px 0">
      <div style="flex:1;min-width:220px;display:flex;gap:8px;align-items:center;border:1px solid var(--line);border-radius:var(--r-md);background:var(--surface);padding:0 12px">
        <span set:html={icons.search} style="width:18px;height:18px;color:var(--ink-faint)" />
        <input
          type="search"
          name="q"
          placeholder="Например: терпение, прощение, свет…"
          autocomplete="off"
          data-search-input
          style="flex:1;height:44px;border:0;background:transparent;color:var(--ink);font-size:16px;outline:none"
        />
      </div>
      <select class="sel" data-search-surah aria-label="Сура">
        <option value="">Все суры</option>
      </select>
      <label class="chip" style="cursor:pointer;user-select:none">
        <input type="checkbox" data-search-exact style="accent-color:var(--accent)" /> Точное слово
      </label>
      <button class="btn primary" type="submit">Найти</button>
    </form>

    <div data-search-status style="color:var(--ink-faint);font-size:14px;margin-bottom:12px"></div>
    <div data-search-results></div>
  </div>

  <script>
    import '../client/search';
  </script>
</Base>
