---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageShell from '../components/ui/PageShell.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import StatTile from '../components/ui/StatTile.astro';
const title = 'Тасбих — электронный счётчик зикров';
const description =
  'Электронный тасбих: считайте зикр (СубханаЛлах, АльхамдулиЛлах, Аллаху Акбар) — большая зона тапа, круги по 33/99/100, тактильный отклик, сохранение прогресса.';
---

<Base {title} {description}>
  <PageShell class="tasbih" narrow data-tasbih>
    <PageHeader
      class="tb-head"
      title="Тасбих"
      description="Счётчик зикров — нажимайте на круг. Прогресс сохраняется на этом устройстве."
    />

    <div class="tb-dhikr" data-dhikr-row>
      <Button variant="ghost" class="tb-dhikr-btn on" data-dhikr="СубханаЛлах">СубханаЛлах</Button>
      <Button variant="ghost" class="tb-dhikr-btn" data-dhikr="АльхамдулиЛлах">АльхамдулиЛлах</Button>
      <Button variant="ghost" class="tb-dhikr-btn" data-dhikr="Аллаху Акбар">Аллаху Акбар</Button>
      <Button variant="ghost" class="tb-dhikr-btn" data-dhikr="Ля иляха илля Ллах">Ля иляха илля Ллах</Button>
      <Button variant="ghost" class="tb-dhikr-btn" data-dhikr="Астагфируллах">Астагфируллах</Button>
    </div>

    <button type="button" class="tb-count" data-count-btn aria-label="Счёт">
      <span class="tb-ring">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="88" class="tb-track"></circle>
          <circle cx="100" cy="100" r="88" class="tb-fill" data-ring pathLength="100"></circle>
        </svg>
        <span class="tb-num" data-num>0</span>
        <span class="tb-of" data-of>из 33</span>
      </span>
    </button>

    <SegmentedControl
      class="tb-targets"
      data-targets
      dataAttr="data-target"
      ariaLabel="Цель круга"
      options={[
        { id: '33', label: '33', selected: true },
        { id: '99', label: '99' },
        { id: '100', label: '100' },
        { id: '0', label: '∞' },
      ]}
    />

    <div class="tb-stats">
      <StatTile label="Кругов сегодня" value="0" stat="rounds" />
      <StatTile label="Всего зикров" value="0" stat="total" />
    </div>

    <div class="tb-actions">
      <Button variant="ghost" data-reset>Сбросить круг</Button>
    </div>
  </PageShell>
</Base>

<script is:inline>
  (function () {
    var K = { st: 'q_tasbih' };
    var $ = function (s) {
      return document.querySelector(s);
    };
    function today() {
      var d = new Date();
      return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
    }
    var st;
    try {
      st = JSON.parse(localStorage.getItem(K.st) || 'null');
    } catch (e) {}
    if (!st || st.day !== today()) st = { day: today(), count: 0, rounds: 0, total: 0, target: 33, dhikr: 'СубханаЛлах' };
    // total сохраняем накопительно между днями
    var saved;
    try {
      saved = JSON.parse(localStorage.getItem(K.st) || 'null');
    } catch (e) {}
    if (saved && saved.day !== today()) st.total = saved.total || 0;

    function save() {
      try {
        localStorage.setItem(K.st, JSON.stringify(st));
      } catch (e) {}
    }
    function haptic(p) {
      try {
        if (navigator.vibrate) navigator.vibrate(p);
      } catch (e) {}
    }
    function render() {
      $('[data-num]').textContent = st.count;
      $('[data-of]').textContent = st.target ? 'из ' + st.target : 'без предела';
      $('[data-stat="rounds"]').textContent = st.rounds;
      $('[data-stat="total"]').textContent = st.total.toLocaleString('ru');
      var pct = st.target ? Math.min(100, Math.round((st.count / st.target) * 100)) : (st.count % 100);
      $('[data-ring]').style.strokeDashoffset = 100 - pct;
      $('[data-count-btn]').classList.toggle('done', st.target && st.count >= st.target);
      document.querySelectorAll('[data-target]').forEach(function (b) {
        b.classList.toggle('on', +b.getAttribute('data-target') === st.target);
      });
      document.querySelectorAll('[data-dhikr]').forEach(function (b) {
        b.classList.toggle('on', b.getAttribute('data-dhikr') === st.dhikr);
      });
    }
    $('[data-count-btn]').addEventListener('click', function () {
      st.count++;
      st.total++;
      if (st.target && st.count >= st.target) {
        st.rounds++;
        haptic([16, 40, 16]);
        setTimeout(function () {
          st.count = 0;
          save();
          render();
        }, 350);
      } else {
        haptic(9);
      }
      save();
      render();
    });
    document.querySelectorAll('[data-target]').forEach(function (b) {
      b.addEventListener('click', function () {
        st.target = +b.getAttribute('data-target');
        save();
        render();
      });
    });
    document.querySelectorAll('[data-dhikr]').forEach(function (b) {
      b.addEventListener('click', function () {
        st.dhikr = b.getAttribute('data-dhikr');
        save();
        render();
      });
    });
    $('[data-reset]').addEventListener('click', function () {
      st.count = 0;
      save();
      render();
    });
    render();
  })();
</script>
