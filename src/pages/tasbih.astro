---
import Base from '../layouts/Base.astro';
const title = 'Тасбих — электронный счётчик зикров';
const description =
  'Электронный тасбих: считайте зикр (СубханаЛлах, АльхамдулиЛлах, Аллаху Акбар) — большая зона тапа, круги по 33/99/100, тактильный отклик, сохранение прогресса.';
---

<Base {title} {description}>
  <div class="container page tasbih" data-tasbih>
    <header class="tb-head">
      <h1>Тасбих</h1>
      <p>Счётчик зикров — нажимайте на круг. Прогресс сохраняется на этом устройстве.</p>
    </header>

    <div class="tb-dhikr" data-dhikr-row>
      <button type="button" class="on" data-dhikr="СубханаЛлах">СубханаЛлах</button>
      <button type="button" data-dhikr="АльхамдулиЛлах">АльхамдулиЛлах</button>
      <button type="button" data-dhikr="Аллаху Акбар">Аллаху Акбар</button>
      <button type="button" data-dhikr="Ля иляха илля Ллах">Ля иляха илля Ллах</button>
      <button type="button" data-dhikr="Астагфируллах">Астагфируллах</button>
    </div>

    <button type="button" class="tb-count" data-count-btn aria-label="Счёт">
      <span class="tb-ring">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="88" class="tb-track"></circle>
          <circle cx="100" cy="100" r="88" class="tb-fill" data-ring pathLength="100"></circle>
        </svg>
        <span class="tb-num" data-num>0</span>
        <span class="tb-of" data-of>из 33</span>
      </span>
    </button>

    <div class="tb-targets" data-targets>
      <button type="button" data-target="33" class="on">33</button>
      <button type="button" data-target="99">99</button>
      <button type="button" data-target="100">100</button>
      <button type="button" data-target="0">∞</button>
    </div>

    <div class="tb-stats">
      <div><span>Кругов сегодня</span><b data-rounds>0</b></div>
      <div><span>Всего зикров</span><b data-total>0</b></div>
    </div>

    <div class="tb-actions">
      <button type="button" class="btn ghost" data-reset>Сбросить круг</button>
    </div>
  </div>
</Base>

<style is:global>
  .tasbih {
    max-width: 520px;
    padding-bottom: 90px;
    text-align: center;
  }
  .tb-head h1 {
    margin: 0 0 6px;
  }
  .tb-head p {
    color: var(--ink-faint);
    font-size: var(--fs-13);
    margin: 0 0 18px;
  }
  .tb-dhikr {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-bottom: 22px;
  }
  .tb-dhikr button {
    border: 1px solid var(--hairline);
    background: transparent;
    color: var(--ink-soft);
    border-radius: var(--radius-pill);
    padding: 7px 14px;
    font: 600 var(--fs-13) / 1 var(--sans);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .tb-dhikr button.on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .tb-count {
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: inline-block;
    -webkit-tap-highlight-color: transparent;
  }
  .tb-count:active {
    transform: scale(0.97);
  }
  .tb-ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: min(74vw, 300px);
    height: min(74vw, 300px);
  }
  .tb-ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .tb-track {
    fill: none;
    stroke: var(--seg-track);
    stroke-width: 10;
  }
  .tb-fill {
    fill: none;
    stroke: var(--accent);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.25s ease;
  }
  .tb-num {
    font-size: clamp(56px, 18vw, 84px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tb-of {
    color: var(--ink-faint);
    font-size: var(--fs-14);
    margin-top: 6px;
  }
  .tb-targets {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 22px 0 18px;
  }
  .tb-targets button {
    min-width: 56px;
    height: 40px;
    border: 1px solid var(--hairline);
    background: transparent;
    color: var(--ink-soft);
    border-radius: var(--radius-md);
    font: 700 var(--fs-16) / 1 var(--sans);
    cursor: pointer;
  }
  .tb-targets button.on {
    background: var(--seg-thumb);
    color: var(--ink);
    box-shadow: 0 1px 2.5px rgba(0, 0, 0, 0.16);
  }
  .tb-stats {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .tb-stats div {
    background: var(--panel-bg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    padding: 12px 18px;
  }
  .tb-stats span {
    display: block;
    color: var(--ink-faint);
    font-size: var(--fs-12);
    margin-bottom: 4px;
  }
  .tb-stats b {
    font-size: 22px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .tb-count.done .tb-fill {
    stroke: var(--good);
  }
</style>

<script is:inline>
  (function () {
    var K = { st: 'q_tasbih' };
    var $ = function (s) {
      return document.querySelector(s);
    };
    function today() {
      var d = new Date();
      return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
    }
    var st;
    try {
      st = JSON.parse(localStorage.getItem(K.st) || 'null');
    } catch (e) {}
    if (!st || st.day !== today()) st = { day: today(), count: 0, rounds: 0, total: 0, target: 33, dhikr: 'СубханаЛлах' };
    // total сохраняем накопительно между днями
    var saved;
    try {
      saved = JSON.parse(localStorage.getItem(K.st) || 'null');
    } catch (e) {}
    if (saved && saved.day !== today()) st.total = saved.total || 0;

    function save() {
      try {
        localStorage.setItem(K.st, JSON.stringify(st));
      } catch (e) {}
    }
    function haptic(p) {
      try {
        if (navigator.vibrate) navigator.vibrate(p);
      } catch (e) {}
    }
    function render() {
      $('[data-num]').textContent = st.count;
      $('[data-of]').textContent = st.target ? 'из ' + st.target : 'без предела';
      $('[data-rounds]').textContent = st.rounds;
      $('[data-total]').textContent = st.total.toLocaleString('ru');
      var pct = st.target ? Math.min(100, Math.round((st.count / st.target) * 100)) : (st.count % 100);
      $('[data-ring]').style.strokeDashoffset = 100 - pct;
      $('[data-count-btn]').classList.toggle('done', st.target && st.count >= st.target);
      document.querySelectorAll('[data-target]').forEach(function (b) {
        b.classList.toggle('on', +b.getAttribute('data-target') === st.target);
      });
      document.querySelectorAll('[data-dhikr]').forEach(function (b) {
        b.classList.toggle('on', b.getAttribute('data-dhikr') === st.dhikr);
      });
    }
    $('[data-count-btn]').addEventListener('click', function () {
      st.count++;
      st.total++;
      if (st.target && st.count >= st.target) {
        st.rounds++;
        haptic([16, 40, 16]);
        setTimeout(function () {
          st.count = 0;
          save();
          render();
        }, 350);
      } else {
        haptic(9);
      }
      save();
      render();
    });
    document.querySelectorAll('[data-target]').forEach(function (b) {
      b.addEventListener('click', function () {
        st.target = +b.getAttribute('data-target');
        save();
        render();
      });
    });
    document.querySelectorAll('[data-dhikr]').forEach(function (b) {
      b.addEventListener('click', function () {
        st.dhikr = b.getAttribute('data-dhikr');
        save();
        render();
      });
    });
    $('[data-reset]').addEventListener('click', function () {
      st.count = 0;
      save();
      render();
    });
    render();
  })();
</script>
