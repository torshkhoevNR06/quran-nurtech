---
import Base from '../../layouts/Base.astro';
import { icons } from '../../lib/icons';
import {
  BASMALA,
  getMushafMeta,
  getMushafPage,
  getMushafSurah,
  mushafTajweedFontFamily,
  mushafTajweedFontCss,
  MUSHAF_TOTAL_PAGES,
} from '../../lib/mushaf';

export function getStaticPaths() {
  return Array.from({ length: MUSHAF_TOTAL_PAGES }, (_, i) => ({
    params: { page: String(i + 1) },
  }));
}

const pageNum = Math.max(1, Math.min(MUSHAF_TOTAL_PAGES, Number(Astro.params.page) || 1));
const page = getMushafPage(pageNum);
const meta = getMushafMeta();
const prevPage = pageNum > 1 ? pageNum - 1 : null;
const nextPage = pageNum < MUSHAF_TOTAL_PAGES ? pageNum + 1 : null;
const title = `Мусхаф, страница ${pageNum} — Коран онлайн`;
const description = `Оригинальная страничная раскладка мусхафа с цветным таджвидом, страница ${pageNum} из ${MUSHAF_TOTAL_PAGES}: QCF V4-глифы, 15 строк и пословная разметка.`;
const linesByNumber = new Map(page.lines.map((line) => [line.n, line]));
const slots = Array.from({ length: 15 }, (_, i) => i + 1);
const starts = page.starts || [];
const startByLine = new Map(starts.map((start) => [start.line, start]));
const decorationByLine = new Map<number, { type: 'surah' | 'basmala'; surah: number }>();
for (const start of starts) {
  if (start.s === 1) {
    decorationByLine.set(Math.max(1, start.line - 1), { type: 'surah', surah: start.s });
  } else if (start.s === 9) {
    decorationByLine.set(Math.max(1, start.line - 1), { type: 'surah', surah: start.s });
  } else {
    decorationByLine.set(Math.max(1, start.line - 2), { type: 'surah', surah: start.s });
    decorationByLine.set(Math.max(1, start.line - 1), { type: 'basmala', surah: start.s });
  }
}
const lineNumbers = page.lines.map((line) => line.n).sort((a, b) => a - b);
const centeredLines = new Set(
  lineNumbers.filter((lineNumber, i) => {
    const next = lineNumbers[i + 1];
    return !next || next > lineNumber + 1 || startByLine.has(next);
  })
);
const surahLabel = starts.length
  ? starts.map((s) => getMushafSurah(meta, s.s)?.na || `Сура ${s.s}`).join(' · ')
  : Array.from(new Set(page.lines.flatMap((line) => line.w.map((word) => Number(word.k.split(':')[0])))))
      .map((s) => getMushafSurah(meta, s)?.na || `Сура ${s}`)
      .join(' · ');
const fontCss = mushafTajweedFontCss(pageNum);
const fontFamily = mushafTajweedFontFamily(pageNum);

// навигация по сурам/джузам: текущие сура и джуз для предвыбора + список джузов→страниц
const currentSurah = starts[0]?.s ?? Number(page.lines[0]?.w[0]?.k.split(':')[0]) ?? 1;
const currentJuz = meta.pageJuz[String(pageNum)] ?? null;
const juzList = Array.from({ length: 30 }, (_, i) => i + 1).map((n) => ({
  n,
  p: meta.juzStart[String(n)] ?? 1,
}));
---

<Base {title} {description} wide pageMode="mushaf">
  <style is:inline set:html={fontCss}></style>
  <style is:inline>
    /* Режим чтения на весь экран (иммерсивный): прячем всю обвязку, разворачиваем страницу */
    .mushaf-immersive-exit {
      display: none;
    }
    body.mushaf-immersive .topbar,
    body.mushaf-immersive .mushaf-toolbar,
    body.mushaf-immersive .mushaf-meta,
    body.mushaf-immersive .mushaf-bottom,
    body.mushaf-immersive .footer,
    body.mushaf-immersive .player,
    body.mushaf-immersive .drawer,
    body.mushaf-immersive .drawer-backdrop {
      display: none !important;
    }
    body.mushaf-immersive {
      padding-left: 0 !important;
    }
    body.mushaf-immersive main.wide {
      height: 100vh;
      height: 100dvh;
      padding: 0;
      overflow: hidden;
    }
    body.mushaf-immersive .mushaf-reader {
      height: 100%;
      display: grid;
      align-items: center;
      padding: 0;
    }
    body.mushaf-immersive .mushaf-sheet {
      max-width: min(96vw, calc((100dvh - 24px) * 0.66));
      margin: 0 auto;
    }
    body.mushaf-immersive .mushaf-immersive-exit {
      display: grid;
      place-items: center;
      position: fixed;
      top: max(12px, env(safe-area-inset-top));
      right: max(12px, env(safe-area-inset-right));
      z-index: 80;
      width: 40px;
      height: 40px;
      border: 1px solid var(--hairline);
      border-radius: 999px;
      background: var(--panel-bg);
      color: var(--ink);
      box-shadow: var(--shadow-pop);
      cursor: pointer;
      opacity: 0.5;
      transition: opacity 0.15s;
    }
    body.mushaf-immersive .mushaf-immersive-exit:hover {
      opacity: 1;
    }
    /* стрелки листания в режиме чтения (клик/десктоп; на мобиле ещё и свайп) */
    .mushaf-imm-nav {
      display: none;
    }
    body.mushaf-immersive .mushaf-imm-nav {
      display: grid;
      place-items: center;
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      z-index: 80;
      width: 46px;
      height: 46px;
      border: 1px solid var(--hairline);
      border-radius: 999px;
      background: var(--panel-bg);
      color: var(--ink);
      box-shadow: var(--shadow-pop);
      opacity: 0.4;
      transition: opacity 0.15s;
    }
    body.mushaf-immersive .mushaf-imm-nav:hover {
      opacity: 1;
    }
    body.mushaf-immersive .mushaf-imm-prev {
      left: max(10px, env(safe-area-inset-left));
    }
    body.mushaf-immersive .mushaf-imm-next {
      right: max(10px, env(safe-area-inset-right));
    }
    .mushaf-imm-nav svg {
      width: 22px;
      height: 22px;
    }
    @media screen and (max-width: 650px) {
      :root {
        --mushaf-vvh: 100vh;
      }
      body[data-page-mode='mushaf'] {
        height: 100vh;
        height: var(--mushaf-vvh);
        overflow: hidden;
      }
      body[data-page-mode='mushaf'] .footer,
      body[data-page-mode='mushaf'] .player,
      body[data-page-mode='mushaf'] .mushaf-bottom {
        display: none !important;
      }
      body[data-page-mode='mushaf'] .topbar {
        position: relative;
        z-index: 60;
        padding-bottom: 0;
      }
      body[data-page-mode='mushaf'] main.wide {
        height: calc(100vh - var(--topbar-h) - max(8px, env(safe-area-inset-top)));
        height: calc(var(--mushaf-vvh) - var(--topbar-h) - max(8px, env(safe-area-inset-top)));
        min-height: 0;
        overflow: hidden;
      }
      body[data-page-mode='mushaf'] .mushaf-reader {
        height: 100%;
        min-height: 0;
        display: grid;
        grid-template-rows: minmax(0, 1fr);
        align-items: center;
        padding: 4px 0 calc(72px + env(safe-area-inset-bottom));
      }
      body[data-page-mode='mushaf'] .mushaf-toolbar {
        position: fixed;
        left: max(8px, env(safe-area-inset-left));
        right: max(8px, env(safe-area-inset-right));
        bottom: max(8px, env(safe-area-inset-bottom));
        z-index: 58;
        width: auto;
        padding: 7px;
        gap: 6px;
        border-radius: 20px;
        flex-wrap: nowrap;
      }
      /* на мобиле навигация мусхафа = стрелки + селекты Сура/Джуз; поле «страница» прячем */
      body[data-page-mode='mushaf'] .mushaf-jump {
        display: none;
      }
      body[data-page-mode='mushaf'] .mushaf-nav-sel {
        flex: 1 1 0;
        min-width: 0;
        max-width: none;
        height: 40px;
        padding: 0 8px;
        font-size: 12px;
      }
      body[data-page-mode='mushaf'] .mushaf-toolbar .icon-btn {
        flex: none;
      }
      body[data-page-mode='mushaf'] .mushaf-sheet {
        width: min(calc(100vw - 12px), calc((var(--mushaf-vvh) - var(--topbar-h) - 128px) * 0.704));
        max-width: none;
        margin: 0 auto;
        padding: 18px 10px 24px;
      }
      body[data-page-mode='mushaf'] .qcf-page {
        font-size: clamp(15.8px, 4.85cqw, 18.6px);
      }
    }
    /* Мобильный режим чтения (fullscreen): страница заполняет ВЕСЬ вьюпорт по
       аспекту, без вычета скрытых топбара/тулбара — иначе аяты обрезались снизу. */
    @media (max-width: 650px) {
      body.mushaf-immersive .mushaf-reader {
        height: 100dvh;
        padding: 0;
      }
      body.mushaf-immersive .mushaf-sheet {
        width: min(calc(100vw - 8px), calc((100dvh - 12px) * 0.66));
        max-width: none;
        margin: 0 auto;
        padding: 8px 6px;
      }
    }
  </style>

  <div class="mushaf-reader">
    <nav class="mushaf-toolbar container" aria-label="Навигация по мусхафу">
      <a class={`icon-btn ${prevPage ? '' : 'disabled'}`} href={prevPage ? `/mushaf/${prevPage}` : undefined} aria-label="Предыдущая страница" title="Предыдущая страница" set:html={icons.arrowLeft} />

      <select class="mushaf-nav-sel" data-mushaf-goto aria-label="Перейти к суре">
        <option value="">Сура…</option>
        {
          meta.suraPages.map((s) => (
            <option value={s.p} selected={s.n === currentSurah ? true : undefined}>
              {s.n}. {s.nr}
            </option>
          ))
        }
      </select>

      <select class="mushaf-nav-sel" data-mushaf-goto aria-label="Перейти к джузу">
        <option value="">Джуз…</option>
        {
          juzList.map((j) => (
            <option value={j.p} selected={j.n === currentJuz ? true : undefined}>
              Джуз {j.n}
            </option>
          ))
        }
      </select>

      <form class="mushaf-jump" action="/mushaf/1" data-mushaf-jump>
        <input id="mushaf-page" name="page" type="number" inputmode="numeric" min="1" max={MUSHAF_TOTAL_PAGES} value={pageNum} aria-label="Номер страницы" />
        <span>/ {MUSHAF_TOTAL_PAGES}</span>
      </form>

      <a class={`icon-btn ${nextPage ? '' : 'disabled'}`} href={nextPage ? `/mushaf/${nextPage}` : undefined} aria-label="Следующая страница" title="Следующая страница" set:html={icons.arrowRight} />

      <button type="button" class="icon-btn" data-mushaf-immersive aria-label="Режим чтения на весь экран" title="Во весь экран (режим чтения)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
      </button>
    </nav>

    <button type="button" class="mushaf-immersive-exit" data-mushaf-immersive aria-label="Выйти из режима чтения" title="Выйти (Esc)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    {prevPage && (
      <a class="mushaf-imm-nav mushaf-imm-prev" href={`/mushaf/${prevPage}`} aria-label="Предыдущая страница" title="Предыдущая страница" set:html={icons.arrowLeft} />
    )}
    {nextPage && (
      <a class="mushaf-imm-nav mushaf-imm-next" href={`/mushaf/${nextPage}`} aria-label="Следующая страница" title="Следующая страница" set:html={icons.arrowRight} />
    )}

    <section class="mushaf-sheet" aria-label={`Страница ${pageNum} мусхафа`}>
      <div class="mushaf-meta">
        <span>{surahLabel}</span>
        <b>{pageNum}</b>
      </div>

      <div class="qcf-page" dir="rtl" data-mushaf-page={pageNum}>
        {
          slots.map((lineNumber) => {
            const line = linesByNumber.get(lineNumber);
            const decoration = decorationByLine.get(lineNumber);
            if (decoration?.type === 'surah') {
              const surah = getMushafSurah(meta, decoration.surah);
              return (
                <div class="qcf-line qcf-line-deco qcf-surah-line" data-line={lineNumber}>
                  <span class="qcf-surah-title">{surah?.na || `سورة ${decoration.surah}`}</span>
                </div>
              );
            }
            if (decoration?.type === 'basmala') {
              return (
                <div class="qcf-line qcf-line-deco qcf-basmala-line" data-line={lineNumber}>
                  <span class="qcf-basmala">{BASMALA}</span>
                </div>
              );
            }
            return (
              <div class={`qcf-line ${line ? '' : 'is-empty'} ${centeredLines.has(lineNumber) ? 'center' : ''}`} data-line={lineNumber}>
                {line?.w.map((word) => (
                  <span
                    class={`qcf-word ${word.e ? 'qcf-word-end' : ''}`}
                    style={`font-family:'${fontFamily}'`}
                    data-ayah-key={word.k}
                    title={word.k}
                  >
                    {word.c}
                  </span>
                ))}
              </div>
            );
          })
        }
      </div>
    </section>

    <nav class="mushaf-bottom container" aria-label="Навигация по страницам">
      <a class={`btn ${prevPage ? '' : 'disabled'}`} href={prevPage ? `/mushaf/${prevPage}` : undefined}>
        <span set:html={icons.arrowLeft} style="width:18px;height:18px" /> Назад
      </a>
      <a class="btn" href="/surah/1">
        <span set:html={icons.book} style="width:18px;height:18px" /> Суры
      </a>
      <a class={`btn primary ${nextPage ? '' : 'disabled'}`} href={nextPage ? `/mushaf/${nextPage}` : undefined}>
        Вперёд <span set:html={icons.arrowRight} style="width:18px;height:18px" />
      </a>
    </nav>
  </div>

  <script is:inline>
    (function () {
      if (!/firefox/i.test(navigator.userAgent)) return;
      document.querySelectorAll('[data-mushaf-page]').forEach(function (page) {
        page.setAttribute('data-mushaf-firefox', '1');
      });
    })();

    (function () {
      if (document.body.getAttribute('data-page-mode') !== 'mushaf') return;
      var root = document.documentElement;
      function syncViewportHeight() {
        var vv = window.visualViewport;
        var height = Math.max(360, Math.floor((vv && vv.height) || window.innerHeight || 0));
        root.style.setProperty('--mushaf-vvh', height + 'px');
      }
      syncViewportHeight();
      window.addEventListener('resize', syncViewportHeight, { passive: true });
      window.addEventListener('orientationchange', syncViewportHeight, { passive: true });
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', syncViewportHeight, { passive: true });
        window.visualViewport.addEventListener('scroll', syncViewportHeight, { passive: true });
      }
    })();

    document.addEventListener('submit', function (event) {
      var form = event.target && event.target.closest && event.target.closest('[data-mushaf-jump]');
      if (!form) return;
      event.preventDefault();
      var input = form.querySelector('input[name="page"]');
      var page = Math.max(1, Math.min(604, parseInt(input && input.value, 10) || 1));
      location.href = '/mushaf/' + page;
    });

    // селекторы «Сура…» / «Джуз…» — переход на страницу мусхафа
    document.addEventListener('change', function (event) {
      var sel = event.target && event.target.closest && event.target.closest('[data-mushaf-goto]');
      if (!sel || !sel.value) return;
      var page = Math.max(1, Math.min(604, parseInt(sel.value, 10) || 1));
      location.href = '/mushaf/' + page;
    });

    // режим чтения на весь экран (иммерсивный) + нативный fullscreen + свайп-листание
    (function () {
      var b = document.body;
      var KEY = 'mushImm';
      var imm = function () {
        return b.classList.contains('mushaf-immersive');
      };
      var enter = function () {
        b.classList.add('mushaf-immersive');
        try {
          sessionStorage.setItem(KEY, '1');
        } catch (e) {}
        var el = document.documentElement;
        if (el.requestFullscreen) el.requestFullscreen().catch(function () {});
      };
      var exit = function () {
        b.classList.remove('mushaf-immersive');
        try {
          sessionStorage.removeItem(KEY);
        } catch (e) {}
        if (document.fullscreenElement && document.exitFullscreen)
          document.exitFullscreen().catch(function () {});
      };
      // восстанавливаем режим чтения после перелистывания (fullscreen API reload не переживает,
      // но CSS-иммерсив — да; страницы листаются, обвязка остаётся скрытой)
      try {
        if (sessionStorage.getItem(KEY) === '1') b.classList.add('mushaf-immersive');
      } catch (e) {}
      document.addEventListener('click', function (e) {
        var t = e.target && e.target.closest && e.target.closest('[data-mushaf-immersive]');
        if (!t) return;
        imm() ? exit() : enter();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && imm()) exit();
      });

      // свайп влево/вправо по странице — листание (работает и в режиме чтения, и обычно)
      var sx = 0,
        sy = 0,
        stime = 0;
      var reader = document.querySelector('.mushaf-reader');
      if (reader) {
        reader.addEventListener(
          'touchstart',
          function (e) {
            var t = e.changedTouches[0];
            sx = t.clientX;
            sy = t.clientY;
            stime = Date.now();
          },
          { passive: true }
        );
        reader.addEventListener(
          'touchend',
          function (e) {
            var t = e.changedTouches[0];
            var dx = t.clientX - sx,
              dy = t.clientY - sy;
            if (Date.now() - stime > 600) return;
            if (Math.abs(dx) < 55 || Math.abs(dx) < Math.abs(dy) * 1.6) return;
            var cur = parseInt((location.pathname.match(/\/mushaf\/(\d+)/) || [])[1], 10) || 1;
            if (dx < 0 && cur < 604) location.href = '/mushaf/' + (cur + 1);
            else if (dx > 0 && cur > 1) location.href = '/mushaf/' + (cur - 1);
          },
          { passive: true }
        );
      }
    })();

    // ← / → — навигация по страницам мусхафа (не в полях ввода)
    document.addEventListener('keydown', function (e) {
      var tag = (e.target && e.target.tagName) || '';
      if (/INPUT|TEXTAREA|SELECT/.test(tag) || e.metaKey || e.ctrlKey || e.altKey) return;
      var cur = parseInt((location.pathname.match(/\/mushaf\/(\d+)/) || [])[1], 10) || 1;
      if (e.key === 'ArrowRight' && cur < 604) location.href = '/mushaf/' + (cur + 1);
      else if (e.key === 'ArrowLeft' && cur > 1) location.href = '/mushaf/' + (cur - 1);
    });
  </script>
</Base>
