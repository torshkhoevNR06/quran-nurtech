---
// Короткая ссылка вида /54:42 — основная страница аята (как на quran-online.ru).
import Base from '../layouts/Base.astro';
import { getSurahs, getSurah, getSurahMeta, getTafsirForAyah, getIbnKathirForAyah, ref } from '../lib/quran';
import { icons } from '../lib/icons';

export function getStaticPaths() {
  const paths = [];
  for (const s of getSurahs()) {
    for (let a = 1; a <= s.c; a++) {
      paths.push({ params: { ref: `${s.n}:${a}` } });
    }
  }
  return paths;
}

const [sN, aN] = String(Astro.params.ref).split(':').map(Number);
const surah = getSurah(sN);
const meta = getSurahMeta(sN)!;
const ayah = surah.a.find((x) => x.n === aN)!;
const taf = getTafsirForAyah(sN, aN);
const ikTaf = getIbnKathirForAyah(sN, aN);

const prev = aN > 1 ? { s: sN, a: aN - 1 } : sN > 1 ? { s: sN - 1, a: getSurah(sN - 1).c } : null;
const next = aN < surah.c ? { s: sN, a: aN + 1 } : sN < 114 ? { s: sN + 1, a: 1 } : null;

const title = `Аят ${sN}:${aN} — сура ${meta.nr} · Коран онлайн`;
const description = `${ayah.ru} — Коран, сура «${meta.nr}» аят ${aN}. Арабский текст, транслитерация, переводы Кулиева и Абу Аделя, тафсиры ас-Саади и Ибн Касира, аудио.`;
---

<Base {title} {description} surahId={sN} ayahId={aN} tr="saadi">
  <div class="container">
    <nav class="crumb">
      <a href="/">Главная</a><span>›</span>
      <a href={`/surah/${sN}`}>{meta.nr}</a><span>›</span>
      <span>Аят {sN}:{aN}</span>
    </nav>

    <header class="surah-head">
      <div class="kicker">Сура {sN} «{meta.nr}» · {meta.nm}</div>
      <h1>Аят {sN}:{aN}</h1>
    </header>

    <div class="ayahs" data-ayahs data-view="all">
      <article class="ayah active" data-ayah-key={ref(sN, aN)}>
        <div class="ayah-top">
          <span class="ayah-no">{sN}:{aN}</span>
          <div class="ayah-acts">
            <button type="button" data-act="play" aria-label="Слушать" title="Слушать" set:html={icons.play} />
            <button type="button" data-bm={ref(sN, aN)} aria-label="Закладка" title="Закладка" set:html={icons.bookmark} />
            <button type="button" data-act="copy" aria-label="Копировать" title="Копировать" set:html={icons.copy} />
            <button type="button" data-act="copy-link" aria-label="Копировать ссылку" title="Ссылка" set:html={icons.share} />
            <a href={`/surah/${sN}#ayah-${aN}`} aria-label="Открыть в суре" title="Открыть в суре" set:html={icons.book} />
          </div>
        </div>

        <div class="ar" set:html={ayah.ar} />

        {ayah.tl && (
          <div class="translit">
            <span class="tafsir-label">Транслитерация</span><br />
            {ayah.tl}
          </div>
        )}

        <div class="translation">
          <span class="tafsir-label">Перевод · Эльмир Кулиев</span><br />
          {ayah.ru}
        </div>

        {ayah.aa && (
          <div class="translation">
            <span class="tafsir-label">Перевод · Абу Адель</span><br />
            {ayah.aa}
          </div>
        )}

        {taf && (
          <details class="tafsir-details">
            <summary>Тафсир ас-Саади · аят {sN}:{aN}</summary>
            <div class="tafsir">{taf.x}</div>
          </details>
        )}

        {ikTaf && (
          <details class="tafsir-details">
            <summary>Тафсир Ибн Касира · аят {sN}:{aN}</summary>
            <div class="tafsir">{ikTaf.x}</div>
          </details>
        )}
      </article>
    </div>

    <nav class="ayah-nav">
      {prev ? (
        <a class="btn" href={`/${prev.s}:${prev.a}`}>
          <span class="ui-inline-icon-sm" set:html={icons.arrowLeft} /> {prev.s}:{prev.a}
        </a>
      ) : (
        <span />
      )}
      <a class="btn" href={`/surah/${sN}#ayah-${aN}`}>Открыть в суре</a>
      {next && (
        <a class="btn" href={`/${next.s}:${next.a}`}>
          {next.s}:{next.a} <span class="ui-inline-icon-sm" set:html={icons.arrowRight} />
        </a>
      )}
    </nav>
  </div>
</Base>
