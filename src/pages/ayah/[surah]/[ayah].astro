---
import Base from '../../../layouts/Base.astro';
import { getSurahs, getSurah, getSurahMeta, getTafsirForAyah, TRANSLATIONS, ref } from '../../../lib/quran';
import { icons } from '../../../lib/icons';

export function getStaticPaths() {
  const paths = [];
  for (const s of getSurahs()) {
    for (let a = 1; a <= s.c; a++) {
      paths.push({ params: { surah: String(s.n), ayah: String(a) } });
    }
  }
  return paths;
}

const sN = Number(Astro.params.surah);
const aN = Number(Astro.params.ayah);
const surah = getSurah(sN);
const meta = getSurahMeta(sN)!;
const ayah = surah.a.find((x) => x.n === aN)!;
const taf = getTafsirForAyah(sN, aN);
const unavailable = TRANSLATIONS.filter((t) => !t.available);

const prev = aN > 1 ? { s: sN, a: aN - 1 } : sN > 1 ? { s: sN - 1, a: getSurah(sN - 1).c } : null;
const next = aN < surah.c ? { s: sN, a: aN + 1 } : sN < 114 ? { s: sN + 1, a: 1 } : null;

const title = `Аят ${sN}:${aN} — сура ${meta.nr} · Коран онлайн`;
const description = `${ayah.ru} — Коран, сура «${meta.nr}» аят ${aN}. Арабский текст, перевод Кулиева, тафсир ас-Саади, аудио.`;
---

<Base {title} {description} surahId={sN} ayahId={aN} tr="saadi">
  <div class="container">
    <nav class="crumb">
      <a href="/">Главная</a><span>›</span>
      <a href={`/surah/${sN}`}>{meta.nr}</a><span>›</span>
      <span>Аят {sN}:{aN}</span>
    </nav>

    <header class="surah-head">
      <div class="kicker">Сура {sN} «{meta.nr}» · {meta.nm}</div>
      <h1>Аят {sN}:{aN}</h1>
    </header>

    <div class="ayahs" data-ayahs data-view="all">
      <article class="ayah active" data-ayah-key={ref(sN, aN)}>
        <div class="ayah-top">
          <span class="ayah-no">{sN}:{aN}</span>
          <div class="ayah-acts">
            <button data-act="play" aria-label="Слушать" title="Слушать" set:html={icons.play} />
            <button data-bm={ref(sN, aN)} aria-label="Закладка" title="Закладка" set:html={icons.bookmark} />
            <button data-act="copy" aria-label="Копировать" title="Копировать" set:html={icons.copy} />
            <button data-act="copy-link" aria-label="Копировать ссылку" title="Ссылка" set:html={icons.share} />
            <a href={`/surah/${sN}#ayah-${aN}`} aria-label="Открыть в суре" title="Открыть в суре" set:html={icons.book} />
          </div>
        </div>

        <div class="ar" set:html={ayah.ar} />

        <div class="translation">
          <span class="tafsir-label">Перевод · Эльмир Кулиев</span><br />
          {ayah.ru}
        </div>

        {taf && (
          <div class="tafsir">
            <span class="tafsir-label">Тафсир ас-Саади · аяты {taf.f}–{taf.t}</span>
            {taf.x}
          </div>
        )}

        {unavailable.map((t) => (
          <div class="tafsir" style="opacity:.6">
            <span class="tafsir-label">{t.name}</span><br />
            <span style="color:var(--ink-faint)">Будет добавлено в следующей версии.</span>
          </div>
        ))}
      </article>
    </div>

    <nav class="ayah-nav">
      {prev ? (
        <a class="btn" href={`/ayah/${prev.s}/${prev.a}`}>
          <span set:html={icons.arrowLeft} style="width:16px;height:16px" /> {prev.s}:{prev.a}
        </a>
      ) : (
        <span />
      )}
      <a class="btn" href={`/surah/${sN}#ayah-${aN}`}>Открыть в суре</a>
      {next && (
        <a class="btn" href={`/ayah/${next.s}/${next.a}`}>
          {next.s}:{next.a} <span set:html={icons.arrowRight} style="width:16px;height:16px" />
        </a>
      )}
    </nav>
  </div>
</Base>
