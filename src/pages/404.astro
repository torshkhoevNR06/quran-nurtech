---
import Base from '../layouts/Base.astro';
---

<Base title="Страница не найдена — Коран онлайн" description="Страница не найдена.">
  <div class="container page" style="text-align:center">
    <h1>Ничего не найдено</h1>
    <p id="hint">Проверяем ссылку…</p>
    <div class="cta" style="justify-content:center;display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
      <a class="btn primary" href="/">На главную</a>
      <a class="btn" href="/search">Поиск</a>
    </div>
  </div>

  <script is:inline>
    // Короткие ссылки вида /2:255 или /2%3A255 → /ayah/2/255
    (function () {
      var p = decodeURIComponent(location.pathname).replace(/^\/+|\/+$/g, '');
      var m = p.match(/^(\d{1,3})[:\-.](\d{1,3})$/);
      if (m) {
        var s = +m[1],
          a = +m[2];
        if (s >= 1 && s <= 114) {
          location.replace('/' + s + ':' + a);
          return;
        }
      }
      var only = p.match(/^(\d{1,3})$/);
      if (only && +only[1] >= 1 && +only[1] <= 114) {
        location.replace('/surah/' + only[1]);
        return;
      }
      var h = document.getElementById('hint');
      if (h) h.textContent = 'Такой страницы нет. Вернитесь на главную или воспользуйтесь поиском.';
    })();
  </script>
</Base>
