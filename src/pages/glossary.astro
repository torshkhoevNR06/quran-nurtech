---
import Base from '../layouts/Base.astro';
const title = 'Словарь исламских терминов — глоссарий Корана';
const description =
  'Краткий словарь ключевых исламских терминов, встречающихся в переводах и тафсирах Корана: таква, тавхид, иман, ихсан, джаннат, барзах и другие — с понятными объяснениями на русском.';

// Курируемый глоссарий (араб · термин · объяснение). Источники — общепринятые словари.
const terms = [
  ['تقوى', 'Таква', 'Богобоязненность — осознанность о Всевышнем, побуждающая выполнять веления и избегать запретного.'],
  ['توحيد', 'Тавхид', 'Единобожие — вера в абсолютную единственность Аллаха в господстве, божественности и именах/качествах.'],
  ['شرك', 'Ширк', 'Придание Аллаху сотоварищей — величайший грех, противоположность тавхида.'],
  ['إيمان', 'Иман', 'Вера — убеждённость сердцем, подтверждение словом и дела органами.'],
  ['إحسان', 'Ихсан', 'Совершенство в поклонении: поклоняться Аллаху, будто видишь Его, а если не видишь — зная, что Он видит тебя.'],
  ['كفر', 'Куфр', 'Неверие — отрицание или сокрытие истины веры.'],
  ['نفاق', 'Нифак', 'Лицемерие — внешнее проявление веры при внутреннем неверии.'],
  ['هدى', 'Худа', 'Прямое руководство, наставление на истинный путь.'],
  ['صراط مستقيم', 'Сырат аль-мустаким', 'Прямой путь — путь пророков, правдивых и праведников.'],
  ['آخرة', 'Ахира', 'Последняя жизнь — вечная жизнь после смерти и воскрешения.'],
  ['برزخ', 'Барзах', 'Промежуточный мир между смертью и Судным днём.'],
  ['جنة', 'Джаннат', 'Рай — вечная обитель награды для верующих.'],
  ['جهنم', 'Джаханнам', 'Ад — обитель наказания.'],
  ['قيامة', 'Кыяма', 'Судный день, воскрешение и великий расчёт.'],
  ['رزق', 'Ризк', 'Удел, пропитание — всё, чем Аллах наделяет творения.'],
  ['قدر', 'Кадар', 'Предопределение — знание и воля Аллаха обо всём сущем.'],
  ['صبر', 'Сабр', 'Терпение — стойкость в подчинении, при бедах и от запретного.'],
  ['شكر', 'Шукр', 'Благодарность Аллаху за блага сердцем, языком и делами.'],
  ['توبة', 'Тавба', 'Покаяние — возвращение к Аллаху с оставлением греха и решимостью не повторять.'],
  ['استغفار', 'Истигфар', 'Просьба о прощении у Аллаха.'],
  ['دعاء', 'Дуа', 'Мольба, обращение к Аллаху с просьбой.'],
  ['ذكر', 'Зикр', 'Поминание Аллаха — словами и сердцем.'],
  ['حلال', 'Халяль', 'Дозволенное по Шариату.'],
  ['حرام', 'Харам', 'Запретное по Шариату.'],
  ['سنة', 'Сунна', 'Путь и практика Пророка ﷺ — слова, дела и одобрения.'],
  ['أمة', 'Умма', 'Община, народ; мусульманская община.'],
  ['وحي', 'Вахй', 'Откровение — ниспослание Аллахом знания пророкам.'],
  ['شفاعة', 'Шафаа', 'Заступничество в Судный день по дозволению Аллаха.'],
  ['ملائكة', 'Малаика', 'Ангелы — созданные из света покорные рабы Аллаха.'],
  ['جن', 'Джинны', 'Сотворённые из огня разумные создания.'],
  ['نبي', 'Наби', 'Пророк — которому ниспослано откровение.'],
  ['رسول', 'Расуль', 'Посланник — пророк с новым Шариатом/посланием к людям.'],
  ['زكاة', 'Закят', 'Обязательная очистительная милостыня с имущества.'],
  ['صدقة', 'Садака', 'Добровольная милостыня.'],
  ['حج', 'Хадж', 'Паломничество в Мекку — пятый столп ислама.'],
  ['صوم', 'Саум', 'Пост — воздержание от еды, питья и прочего от рассвета до заката.'],
  ['قبلة', 'Кибла', 'Направление на Каабу, к которому обращаются в молитве.'],
  ['بركة', 'Барака', 'Благодать — умножение блага от Аллаха.'],
];
---

<Base {title} {description}>
  <div class="container page gloss">
    <header class="gl-head">
      <h1>Словарь терминов</h1>
      <p>Ключевые исламские понятия из переводов и тафсиров — коротко и по-русски.</p>
      <input type="search" placeholder="Найти термин…" data-gl-search aria-label="Поиск термина" />
    </header>

    <div class="gl-list" data-gl-list>
      {
        terms.map(([ar, ru, def]) => (
          <article class="gl-term" data-search={`${ru} ${def} ${ar}`.toLowerCase()}>
            <div class="gl-t">
              <b>{ru}</b>
              <span class="gl-ar" dir="rtl">{ar}</span>
            </div>
            <p>{def}</p>
          </article>
        ))
      }
    </div>
    <p class="gl-empty" data-gl-empty hidden>Ничего не найдено.</p>
  </div>
</Base>

<style is:global>
  .gloss {
    max-width: 720px;
    padding-bottom: 90px;
  }
  .gl-head h1 {
    margin: 0 0 6px;
  }
  .gl-head p {
    color: var(--ink-faint);
    font-size: var(--fs-13);
    margin: 0 0 14px;
  }
  .gl-head input {
    width: 100%;
    height: 40px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--seg-thumb);
    color: var(--ink);
    padding: 0 14px;
    font: 500 16px / 1 var(--sans);
  }
  .gl-list {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .gl-term {
    background: var(--panel-bg);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    padding: 14px 16px;
  }
  .gl-t {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 5px;
  }
  .gl-t b {
    font-size: var(--fs-16);
    font-weight: var(--weight-semibold);
  }
  .gl-ar {
    font-family: var(--ar-font), serif;
    color: var(--ink-faint);
    font-size: var(--fs-16);
  }
  .gl-term p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-14);
    line-height: 1.55;
  }
  .gl-empty {
    text-align: center;
    color: var(--ink-faint);
    margin-top: 24px;
  }
</style>

<script is:inline>
  (function () {
    var inp = document.querySelector('[data-gl-search]');
    var empty = document.querySelector('[data-gl-empty]');
    if (!inp) return;
    inp.addEventListener('input', function () {
      var q = inp.value.trim().toLowerCase();
      var shown = 0;
      document.querySelectorAll('.gl-term').forEach(function (t) {
        var hit = !q || (t.getAttribute('data-search') || '').indexOf(q) !== -1;
        t.style.display = hit ? '' : 'none';
        if (hit) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  })();
</script>
