[{"a":1,"h":"أَرَءَيْتَ <span class=\"tj tj-h\">ٱ</span>لَّذِى يُكَذِّبُ بِ<span class=\"tj tj-h\">ٱ</span><span class=\"tj tj-l\">ل</span>دّ<span class=\"tj tj-p\">ِي</span>نِ"},{"a":2,"h":"فَذ<span class=\"tj tj-n\">َٲ</span>لِكَ <span class=\"tj tj-h\">ٱ</span>لَّذِى يَدُعُّ <span class=\"tj tj-h\">ٱ</span>لْيَت<span class=\"tj tj-p\">ِي</span>مَ"},{"a":3,"h":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ <span class=\"tj tj-h\">ٱ</span>لْمِسْك<span class=\"tj tj-p\">ِي</span>نِ"},{"a":4,"h":"فَوَيْ<span class=\"tj tj-u\">لٌ ل</span>ِّلْمُصَلّ<span class=\"tj tj-p\">ِي</span>نَ"},{"a":5,"h":"ٱلَّذِينَ هُمْ عَ<span class=\"tj tj-f\">ن ص</span>َلَاتِهِمْ سَاه<span class=\"tj tj-p\">ُو</span>نَ"},{"a":6,"h":"ٱلَّذِينَ هُمْ يُر<span class=\"tj tj-o\">َا</span>ٓء<span class=\"tj tj-p\">ُو</span>نَ"},{"a":7,"h":"وَيَمْنَعُونَ <span class=\"tj tj-h\">ٱ</span>لْمَاع<span class=\"tj tj-p\">ُو</span>نَ"}]