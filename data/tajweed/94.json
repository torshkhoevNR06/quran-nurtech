[{"a":1,"h":"أَلَمْ نَشْرَحْ لَكَ صَ<span class=\"tj tj-q\">دْ</span>رَكَ"},{"a":2,"h":"وَوَضَعْنَا عَ<span class=\"tj tj-f\">نك</span>َ وِزْرَكَ"},{"a":3,"h":"ٱلَّذ<span class=\"tj tj-o\">ِىٓ</span> أَ<span class=\"tj tj-f\">نق</span>َضَ ظَهْرَكَ"},{"a":4,"h":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"a":5,"h":"فَإِ<span class=\"tj tj-g\">نّ</span>َ مَعَ <span class=\"tj tj-h\">ٱ</span>لْعُسْرِ يُسْرًا"},{"a":6,"h":"إِ<span class=\"tj tj-g\">نّ</span>َ مَعَ <span class=\"tj tj-h\">ٱ</span>لْعُسْرِ يُسْرًا"},{"a":7,"h":"فَإِذَا فَرَغْتَ فَ<span class=\"tj tj-h\">ٱ</span><span class=\"tj tj-f\">نص</span>َ<span class=\"tj tj-q\">بْ</span>"},{"a":8,"h":"وَإِلَىٰ رَبِّكَ فَ<span class=\"tj tj-h\">ٱ</span>رْغَ<span class=\"tj tj-q\">ب</span>"}]