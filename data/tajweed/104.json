[{"a":1,"h":"وَيْ<span class=\"tj tj-u\">لٌ ل</span>ِّكُلِّ هُمَزَ<span class=\"tj tj-u\">ةٍ ل</span>ُّمَزَةٍ"},{"a":2,"h":"ٱلَّذِى جَمَعَ مَال<span class=\"tj tj-a\">اً و</span>َعَدَّدَهُۥ"},{"a":3,"h":"يَحْسَبُ أَ<span class=\"tj tj-g\">نّ</span>َ مَالَهُ<span class=\"tj tj-o\">ۥٓ</span> أَخْلَدَهُۥ"},{"a":4,"h":"كَلَّا‌ۖ لَيُ<span class=\"tj tj-i\">نۢب</span>َذَ<span class=\"tj tj-g\">نّ</span>َ فِى <span class=\"tj tj-h\">ٱ</span>لْحُطَمَةِ"},{"a":5,"h":"وَم<span class=\"tj tj-o\">َآ</span> أَ<span class=\"tj tj-q\">دْ</span>رَ<span class=\"tj tj-n\">ٮٰ</span>كَ مَا <span class=\"tj tj-h\">ٱ</span>لْحُطَمَةُ"},{"a":6,"h":"نَارُ <span class=\"tj tj-h\">ٱ</span>للَّهِ <span class=\"tj tj-h\">ٱ</span>لْمُوقَدَةُ"},{"a":7,"h":"ٱلَّتِى تَطَّلِعُ عَلَى <span class=\"tj tj-h\">ٱ</span>لْأَفْــِٔدَةِ"},{"a":8,"h":"إِ<span class=\"tj tj-g\">نّ</span>َهَا عَلَيْه<span class=\"tj tj-w\">ِم م</span>ُّؤْصَدَةٌ"},{"a":9,"h":"فِى عَمَ<span class=\"tj tj-a\">دٍ م</span>ُّمَدَّدَةِۭ"}]