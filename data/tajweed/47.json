َإِ<span class=\"tj tj-g\">مّ</span>َا مَ<span class=\"tj tj-g\">نّ</span><span class=\"tj tj-i\">َۢا ب</span>َعْدُ وَإِ<span class=\"tj tj-g\">مّ</span>َا فِد<span class=\"tj tj-o\">َا</span>ٓءً حَتَّىٰ تَضَعَ <span class=\"tj tj-h\">ٱ</span>لْحَرْبُ أَوْزَارَهَا‌ۚ ذ<span class=\"tj tj-n\">َٲ</span>لِكَ وَلَوْ يَش<span class=\"tj tj-o\">َا</span>ٓءُ <span class=\"tj tj-h\">ٱ</span>للَّهُ لَ<span class=\"tj tj-h\">ٱ</span><span class=\"tj tj-f\">نت</span>َصَرَ مِنْهُمْ وَلَ<span class=\"tj tj-n\">ـٰ</span>ك<span class=\"tj tj-u\">ِن ل</span>ِّيَ<span class=\"tj tj-q\">بْ</span>لُوَ<span class=\"tj tj-s\">اْ</span> بَعْضَك<span class=\"tj tj-c\">ُم ب</span>ِبَعْ<span class=\"tj tj-a\">ضٍ‌ۗ و</span>َ<span class=\"tj tj-h\">ٱ</span>لَّذِينَ قُتِلُو<span class=\"tj tj-s\">اْ</span> فِى سَبِيلِ <span class=\"tj tj-h\">ٱ</span>للَّهِ فَل<span class=\"tj tj-a\">َن ي</span>ُضِلَّ أَعْمَ<span class=\"tj tj-n\">ـٰ</span>لَهُمْ"},{"a":5,"h":"سَيَهْدِيهِمْ وَيُصْلِحُ بَالَهُمْ"},{"a":6,"h":"وَيُ<span class=\"tj tj-q\">دْ</span>خِلُهُمُ <span class=\"tj tj-h\">ٱ</span>لْجَ<span class=\"tj tj-g\">نّ</span>َةَ عَرَّفَهَا لَهُمْ"},{"a":7,"h":"يَ<span class=\"tj tj-o\">ـٰٓ</span>أَيُّهَا <span class=\"tj tj-h\">ٱ</span>لَّذِينَ ءَامَن<span class=\"tj tj-o\">ُوٓ</span><span class=\"tj tj-s\">اْ</span> إِ<span class=\"tj tj-f\">ن ت</span>َ<span class=\"tj tj-f\">نص</span>ُرُو<span class=\"tj tj-s\">اْ</span> <span class=\"tj tj-h\">ٱ</span>للَّهَ يَ<span class=\"tj tj-f\">نص</span>ُرْكُمْ وَيُثَبِّتْ أَ<span class=\"tj tj-q\">قْ</span>دَامَكُمْ"},{"a":8,"h":"وَ<span class=\"tj tj-h\">ٱ</span>لَّذِينَ كَفَرُو<span class=\"tj tj-s\">اْ</span> فَتَعْ<span class=\"tj tj-u\">سًا ل</span>َّهُمْ وَأَضَلَّ أَعْمَ<span class=\"tj tj-n\">ـٰ</span>لَهُمْ"},{"a":9,"h":"ذ<span class=\"tj tj-n\">َٲ</span>لِكَ بِأَ<span class=\"tj tj-g\">نّ</span>َهُمْ كَرِهُو<span class=\"tj tj-s\">اْ</span> م<span class=\"tj tj-o\">َآ</span> أَ<span class=\"tj tj-f\">نز</span>َلَ <span class=\"tj tj-h\">ٱ</span>ل