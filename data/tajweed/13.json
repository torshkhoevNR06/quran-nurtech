 يَش<span class=\"tj tj-o\">َا</span>ٓءُ وَيُثْبِتُ‌ۖ وَعِ<span class=\"tj tj-f\">ند</span>َهُ<span class=\"tj tj-o\">ۥٓ</span> أُ<span class=\"tj tj-g\">مّ</span>ُ <span class=\"tj tj-h\">ٱ</span>لْكِتَ<span class=\"tj tj-p\">ـٰ</span><span class=\"tj tj-q\">ب</span>ِ"},{"a":40,"h":"وَإ<span class=\"tj tj-a\">ِن م</span>َّا نُرِيَ<span class=\"tj tj-g\">نّ</span>َكَ بَعْضَ <span class=\"tj tj-h\">ٱ</span>لَّذِى نَعِدُهُمْ أَوْ نَتَوَفَّيَ<span class=\"tj tj-g\">نّ</span>َكَ فَإِ<span class=\"tj tj-g\">نّ</span>َمَا عَلَيْكَ <span class=\"tj tj-h\">ٱ</span>لْبَلَ<span class=\"tj tj-n\">ـٰ</span>غُ وَعَلَيْنَا <span class=\"tj tj-h\">ٱ</span>لْحِس<span class=\"tj tj-p\">َا</span><span class=\"tj tj-q\">ب</span>ُ"},{"a":41,"h":"أَوَلَمْ يَرَوْ<span class=\"tj tj-s\">اْ</span> أَ<span class=\"tj tj-g\">نّ</span>َا نَأْتِى <span class=\"tj tj-h\">ٱ</span>لْأَرْضَ نَ<span class=\"tj tj-f\">نق</span>ُصُهَا مِنْ أَ<span class=\"tj tj-q\">طْ</span>رَافِهَا‌ۚ وَ<span class=\"tj tj-h\">ٱ</span>للَّهُ يَحْكُمُ لَا مُعَقِّبَ لِحُكْمِه<span class=\"tj tj-n\">ِۦ</span>‌ۚ وَهُوَ سَرِيعُ <span class=\"tj tj-h\">ٱ</span>لْحِس<span class=\"tj tj-p\">َا</span><span class=\"tj tj-q\">ب</span>ِ"},{"a":42,"h":"وَقَ<span class=\"tj tj-q\">دْ</span> مَكَرَ <span class=\"tj tj-h\">ٱ</span>لَّذِينَ مِ<span class=\"tj tj-f\">ن ق</span>َ<span class=\"tj tj-q\">بْ</span>لِهِمْ فَلِلَّهِ <span class=\"tj tj-h\">ٱ</span>لْمَكْرُ جَمِي<span class=\"tj tj-a\">عًا‌ۖ ي</span>َعْلَمُ مَا تَكْسِبُ كُلُّ نَفْ<span class=\"tj tj-a\">سٍ‌ۗ و</span>َسَيَعْلَمُ <span class=\"tj tj-h\">ٱ</span>لْكُفَّ<span class=\"tj tj-n\">ـٰ</span>رُ لِمَنْ عُ<span class=\"tj tj-q\">قْ</span>بَى <span class=\"tj tj-h\">ٱ</span><span class=\"tj tj-l\">ل</span>دّ<span class=\"tj tj-p\">َا</span>رِ"},{"a":43,"h":"وَيَقُولُ <span class=\"tj tj-h\">ٱ</span>لَّذِينَ كَفَرُو<span class=\"tj tj-s\">اْ</span> لَسْتَ مُرْسَل<span class=\"tj tj-f\">اً‌ۚ ق</span>ُلْ كَفَىٰ بِ<span class=\"tj tj-h\">ٱ</span>للَّهِ شَهِيد<span class=\"tj tj-i\">َۢا ب</span>َيْنِى وَبَيْنَكُمْ وَمَنْ عِ<span class=\"tj tj-f\">ند</span>َهُ<span class=\"tj tj-n\">ۥ</span> عِلْمُ <span class=\"tj tj-h\">ٱ</span>لْكِتَ<span class=\"tj tj-p\">ـٰ</span><span class=\"tj tj-q\">ب</span>ِ"}]