[{"a":1,"h":"إِذَا زُلْزِلَتِ <span class=\"tj tj-h\">ٱ</span>لْأَرْضُ زِلْزَالَهَا"},{"a":2,"h":"وَأَخْرَجَتِ <span class=\"tj tj-h\">ٱ</span>لْأَرْضُ أَثْقَالَهَا"},{"a":3,"h":"وَقَالَ <span class=\"tj tj-h\">ٱ</span>لْإِ<span class=\"tj tj-f\">نس</span>َ<span class=\"tj tj-n\">ـٰ</span>نُ مَا لَهَا"},{"a":4,"h":"يَوْمَئِ<span class=\"tj tj-f\">ذٍ ت</span>ُحَدِّثُ أَخْبَارَهَا"},{"a":5,"h":"بِأَ<span class=\"tj tj-g\">نّ</span>َ رَبَّكَ أَوْحَىٰ لَهَا"},{"a":6,"h":"يَوْمَئِ<span class=\"tj tj-a\">ذٍ ي</span>َصْدُرُ <span class=\"tj tj-h\">ٱ</span><span class=\"tj tj-l\">ل</span><span class=\"tj tj-g\">نّ</span>َاسُ أَشْتَا<span class=\"tj tj-u\">تًا ل</span>ِّيُرَوْ<span class=\"tj tj-s\">اْ</span> أَعْمَ<span class=\"tj tj-n\">ـٰ</span>لَهُمْ"},{"a":7,"h":"فَم<span class=\"tj tj-a\">َن ي</span>َعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْ<span class=\"tj tj-a\">رًا ي</span>َرَهُۥ"},{"a":8,"h":"وَم<span class=\"tj tj-a\">َن ي</span>َعْمَلْ مِثْقَالَ ذَرَّ<span class=\"tj tj-f\">ةٍ ش</span>َر<span class=\"tj tj-a\">ًّا ي</span>َرَهُۥ"}]