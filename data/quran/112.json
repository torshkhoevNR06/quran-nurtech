{"n":112,"na":"سُورَةُ الإِخۡلَاصِ","ne":"Al-Ikhlaas","nr":"Аль-Ихлас","nm":"Искренность","t":"мекканская","c":4,"bism":true,"a":[{"n":1,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","tj":"قُلْ هُوَ [h:8078[ٱ]للَّهُ أَحَ[q[د]ٌ","ru":"Скажи: «Он - Аллах Единый,","aa":"Скажи: «Он – Аллах – один [нет у Него сотоварища],"},{"n":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tj":"ٱللَّهُ [h:14675[ٱ][l[ل]صَّمَ[q[د]ُ","ru":"Аллах Самодостаточный.","aa":"Аллах – Един (Своей сущностью);"},{"n":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","tj":"لَمْ يَلِ[q:14676[دْ] وَلَمْ يُولَ[q:14677[دْ]","ru":"Он не родил и не был рожден,","aa":"Он (никого) не родил и (Сам Он) не был рожден,"},{"n":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","tj":"وَلَمْ يَك[u:2596[ُن ل]َّهُ[n[ۥ] كُفُوًا أَحَ[q[د]ُۢ","ru":"и нет никого равного Ему».","aa":"и не стал Ему равным ни один [Ему нет ни равного и ни подобного]!»"}]}